---
// Boundary UC-05 Membaca Transkrip Percakapan, halaman Riwayat Percakapan (REQ-5.1, T-F6.1-02, SRS 3.1.7): ringkasan
// periode dan Daftar Percakapan dari view riwayat_percakapan. Detail transkrip ada di /riwayat-percakapan/detail.
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { chip } from '../lib/data';
import { PESAN_RIWAYAT, nomorHalaman } from '../lib/TranskripController';
import { transkrip } from '../lib/riwayatPercakapan';

const hasil = await transkrip(Astro.locals.tokenAkses).ambilDaftarPercakapan({ halaman: Astro.url.searchParams.get('halaman') });
const gagal = 'gagal' in hasil ? hasil.gagal : '';
const d = 'gagal' in hasil ? null : hasil;
// Penyimpanan gagal: 503 (PROJECT_RULES 4.4).
if (gagal) Astro.response.status = 503;

const fmt = (n: number) => n.toLocaleString('id-ID');
const KARTU = [
  { label: 'Total Percakapan', value: d?.ringkasan.total, icon: 'icon-messages-square', bg: '#e3ecff', fg: '#2f6bf5' },
  { label: 'Informasi Produk', value: d?.ringkasan.informasiProduk, icon: 'icon-search-check', bg: '#dcf5e6', fg: '#16a34a' },
  { label: 'Pengaduan Produk', value: d?.ringkasan.pengaduanProduk, icon: 'icon-clipboard-list', bg: '#ece7fe', fg: '#6d4aff' },
  { label: 'Dieskalasi ke Petugas', value: d?.ringkasan.dieskalasi, icon: 'icon-user-round', bg: '#fdf0d3', fg: '#b26b00' },
];
const tautan = (h: number) => (h === 1 ? '/riwayat-percakapan' : `/riwayat-percakapan?halaman=${h}`);
---
<DashboardLayout title="Riwayat Percakapan">
  <div class="page">
    <section class="panel head">
      <div class="head-title">
        <h1>Riwayat Percakapan</h1>
        <span>Ringkasan Periode{d && ` · ${d.labelPeriode}`}</span>
      </div>
    </section>

    <div class="cards" data-name="RingkasanPeriode">
      {KARTU.map((k) => (
        <div class="panel stat">
          <div class="stat-head"><span>{k.label}</span><span class="stat-icon" style={`background:${k.bg};color:${k.fg}`}><i class={k.icon}></i></span></div>
          <span class="stat-value">{k.value === undefined ? '—' : fmt(k.value)}</span>
        </div>
      ))}
    </div>

    <section class="panel list" data-name="DaftarPercakapan">
      <div class="list-head">
        <h2>Daftar Percakapan</h2>
        <span>Semua panggilan tercatat pada register layanan · data pribadi pelapor disamarkan</span>
      </div>
      <div class="row-grid cols-head" aria-hidden="true"><span>WAKTU</span><span>JENIS</span><span>RINGKASAN</span><span>NOMOR TIKET</span><span>NOMOR TELEPON</span><span>PENYELESAIAN</span><span>AKSI</span></div>
      {gagal && <div class="empty" role="alert"><i class="icon-file-x"></i><span>{gagal}</span></div>}
      {d && d.percakapan.length === 0 && <div class="empty"><i class="icon-history"></i><span>{PESAN_RIWAYAT.kosong}</span></div>}
      <ol class="rows" aria-label="Daftar percakapan">
        {d?.percakapan.map((p) => {
          const warna = chip(p.labelStatus);
          return (
            <li class="row-grid tile row">
              <span class="mono">{p.waktu}</span>
              <span>{p.jenis}</span>
              <span class="ringkasan">{p.ringkasan}</span>
              <span class="mono">{p.noTiket}</span>
              <span class="mono">{p.noTelp}</span>
              <span class="chip" style={`background:${warna.bg};color:${warna.fg}`}>{p.labelStatus}</span>
              <a href={p.tautanTranskrip} class="pill lihat"><i class="icon-file-text"></i>Lihat Transkrip</a>
            </li>
          );
        })}
      </ol>
    </section>

    {d && d.ringkasan.total > 0 && (
      <nav class="pager" aria-label="Halaman Daftar Percakapan">
        <span>Menampilkan {d.awal}–{d.akhir} dari {fmt(d.ringkasan.total)} percakapan</span>
        <span class="grow"></span>
        {d.halaman > 1 ? <a href={tautan(d.halaman - 1)} class="pill pg" aria-label="Halaman sebelumnya"><i class="icon-chevron-left"></i></a> : <span class="pill pg off" aria-hidden="true"><i class="icon-chevron-left"></i></span>}
        {nomorHalaman(d.halaman, d.jumlahHalaman).map((n) =>
          n === null ? <span class="gap">…</span> : <a href={tautan(n)} class:list={['pill pg', { now: n === d.halaman }]} aria-current={n === d.halaman ? 'page' : undefined}>{n}</a>,
        )}
        {d.halaman < d.jumlahHalaman ? <a href={tautan(d.halaman + 1)} class="pill pg" aria-label="Halaman berikutnya"><i class="icon-chevron-right"></i></a> : <span class="pill pg off" aria-hidden="true"><i class="icon-chevron-right"></i></span>}
      </nav>
    )}
  </div>
</DashboardLayout>

<style>
  .page { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 20px; }
  .grow { flex: 1; }
  .head { padding: 22px 28px; display: flex; align-items: center; gap: 16px; }
  .head-title { flex: 1; display: flex; flex-direction: column; gap: 4px; }
  .head h1 { margin: 0; font-size: 34px; font-weight: 400; letter-spacing: -.02em; }
  .head-title span { font-size: 15px; color: var(--muted); }

  .cards { flex: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  .stat { padding: 20px 24px; display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .stat-head { display: flex; align-items: center; justify-content: space-between; gap: 6px; font-size: 15px; color: #4b5260; }
  .stat-icon { width: 36px; height: 36px; flex: none; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 17px; }
  .stat-value { font-size: 38px; font-weight: 500; letter-spacing: -.02em; }

  .list { flex: 1; min-height: 0; padding: 18px 20px; display: flex; flex-direction: column; gap: 8px; overflow: auto; }
  .list-head { display: flex; flex-direction: column; gap: 2px; padding: 4px 18px 8px; }
  .list-head h2 { margin: 0; font-size: 22px; font-weight: 400; }
  .list-head span { font-size: 14px; color: var(--muted); }
  /* Kolom aksi berlebar tetap agar kolom judul dan baris membagi lebar yang sama. */
  .row-grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1fr) minmax(0, 2.4fr) minmax(0, 1.3fr) minmax(0, 1fr) minmax(0, 1.2fr) 168px; gap: 14px; align-items: center; padding: 0 18px; }
  .cols-head { font-size: 12.5px; font-weight: 600; letter-spacing: .1em; color: var(--muted); padding-bottom: 4px; }
  .rows { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 8px; }
  .row { min-height: 64px; border-radius: 18px; font-size: 15px; }
  .ringkasan { overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .row .chip { justify-self: start; }
  .lihat { height: 44px; padding: 0 16px; font-size: 14px; font-weight: 500; color: var(--ink); }
  .empty { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; font-size: 17px; color: var(--ink-3); border-radius: 22px; background: var(--surface); border: 1px dashed #dde0e5; min-height: 220px; }
  .empty i { font-size: 28px; color: var(--muted-2); }

  .pager { flex: none; display: flex; align-items: center; gap: 8px; padding: 0 8px; font-size: 15px; color: var(--muted); }
  .pg { height: 42px; min-width: 42px; padding: 0 12px; justify-content: center; font-size: 15px; }
  .pg.now { background: #2f6bf5; border-color: #2f6bf5; color: #fff; }
  .pg.off { opacity: .45; }
  .gap { padding: 0 4px; }
</style>
