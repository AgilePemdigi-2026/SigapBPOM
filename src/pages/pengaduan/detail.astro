---
// Boundary UC-04 & UC-06, halaman Detail Pengaduan yang dibuka tombol "Buka Kasus" atau "Telaah" (REQ-4.4, REQ-6.1 - REQ-6.6, T-F7.2-02, SRS 3.1.10).
// Menampilkan ringkasan berkas pengaduan, data pelapor tersamar (NFR-13), StepperPenanganan pengaduan, dan kontak pelapor
// untuk tindak lanjut lewat WhatsApp atau telepon (ADR 0006): satu-satunya halaman yang menerima nomor lengkap.
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import StepperPenanganan from '../../components/StepperPenanganan.astro';
import { chip } from '../../lib/data';
import { pemantauanLayanan } from '../../lib/pemantauan';
import { daftarPengaduan } from '../../lib/daftarPengaduan';
import { LABEL_JENIS_TIKET, PESAN_PEMANTAUAN } from '../../lib/PemantauanLayananController';
import { ambilKontakPelapor, penangananPetugas } from '../../lib/penanganan';
import { tampilNomor, tautanTelepon, tautanWhatsApp, teksWhatsApp } from '../../lib/kontakPelapor';

const pemantauan = pemantauanLayanan(Astro.locals.tokenAkses);
let noTiket = Astro.url.searchParams.get('tiket');
if (!noTiket) {
  const daftar = await daftarPengaduan(Astro.locals.tokenAkses, {});
  if ('pengaduan' in daftar && daftar.pengaduan.length > 0) {
    noTiket = daftar.pengaduan[0].noTiket;
  } else {
    const antrean = await pemantauan.antreanTiket();
    if ('tiket' in antrean && antrean.tiket.length > 0) {
      const pengaduan = antrean.tiket.find((t) => t.jenis.toLowerCase() === 'pengaduan') || antrean.tiket[0];
      noTiket = pengaduan.noTiket;
    }
  }
}

const hasil = await pemantauan.detailKasus(noTiket);
const gagal = 'gagal' in hasil ? hasil.gagal : '';
const d = 'gagal' in hasil ? null : hasil;
// Tiket tidak ada: 404; penyimpanan gagal: 503 (PROJECT_RULES 4.4).
if (!d) Astro.response.status = gagal === PESAN_PEMANTAUAN.detailGagalDimuat ? 503 : 404;

// Isian penanganan yang sudah tersimpan, agar stepper tetap utuh setelah halaman dimuat ulang (SRS 4.6 Alternative
// Path 2: formulir jadwal tetap tampil setelah telaah "Perlu Pemeriksaan Lapangan"). Gagal dibaca: stepper kosong.
const terbaru = <T extends { waktu: string }>(baris: T[]) => [...baris].sort((a, b) => b.waktu.localeCompare(a.waktu))[0];
const penanganan = penangananPetugas(Astro.locals.tokenAkses);
const [telaah, jadwal, tanggapan] = d && d.jenis === LABEL_JENIS_TIKET.pengaduan
  ? await Promise.all([
      penanganan.ambilRiwayatTelaah(d.noTiket).then(terbaru).catch(() => undefined),
      penanganan.ambilJadwal(d.noTiket).then(terbaru).catch(() => undefined),
      penanganan.ambilTanggapan(d.noTiket).then(terbaru).catch(() => undefined),
    ])
  : [];
const warna = d ? chip(d.labelStatus) : null;

// Kontak pelapor (ADR 0006). Gagal dibaca: panel memakai nomor tersamar tanpa tombol.
const kontak = d ? await ambilKontakPelapor(penanganan, d.noTiket) : null;
const jenisKontak = d?.jenis === LABEL_JENIS_TIKET.pengaduan ? 'pengaduan' : 'eskalasi';
// Setelah tanggapan resmi tersimpan, petugas mengirimkannya lalu menandai sudah dihubungi sebelum menutup tiket (ADR 0006).
const adaTanggapan = d?.status === 'tanggapan_disusun' || d?.status === 'selesai';
const petugas = Astro.locals.petugas;
const tautanWa = d && kontak ? tautanWhatsApp(kontak.noTelp, teksWhatsApp({ jenis: jenisKontak, noTiket: d.noTiket, kirimTanggapan: adaTanggapan, tanggapan: tanggapan?.isi, petugas: petugas?.nama })) : null;
const tautanTel = kontak ? tautanTelepon(kontak.noTelp) : null;
// Pengaduan ditandai setelah tanggapan resmi tersimpan; eskalasi kapan saja karena jawabannya disampaikan saat dihubungi.
const bolehTandai = Boolean(kontak && !kontak.sudahDihubungi && (jenisKontak === 'eskalasi' || adaTanggapan));
const waktuDihubungi = kontak?.dihubungiPada
  ? new Intl.DateTimeFormat('id-ID', { timeZone: 'Asia/Jakarta', dateStyle: 'medium', timeStyle: 'short' }).format(new Date(kontak.dihubungiPada))
  : '';
---
<DashboardLayout title={d ? `Detail Pengaduan ${d.noTiket}` : 'Detail Pengaduan'}>
  <div class="page">
    <a href="/ringkasan" class="pill back"><i class="icon-arrow-left"></i>Kembali ke Ringkasan Layanan</a>
    {d ? (
      <>
        <section class="panel head" data-name="DetailPengaduan">
          <div class="head-title">
            <span class="eyebrow">{d.jenis.toUpperCase()}</span>
            <h1 class="mono">{d.noTiket}</h1>
          </div>
          <span class="chip big" data-name="StatusPengaduan" style={`background:${warna!.bg};color:${warna!.fg}`}>{d.labelStatus}</span>
        </section>

        {/* UC-06 khusus tiket pengaduan; RPC penanganan menolak tiket eskalasi. */}
        {d.jenis === LABEL_JENIS_TIKET.pengaduan && <StepperPenanganan
          noTiket={d.noTiket}
          status={d.status}
          labelStatus={d.labelStatus}
          tindakLanjut={telaah?.tindakLanjut ?? null}
          catatan={telaah?.catatan ?? ''}
          tanggalPemeriksaan={jadwal?.tanggal ?? ''}
          unitPelaksana={jadwal?.unitPelaksana ?? ''}
          tanggapan={tanggapan?.isi ?? ''}
        />}

        <div class="grid">
          <section class="panel card">
            <h2>Data Pengaduan</h2>
            <p class="ringkasan">{d.ringkasan}</p>
            <dl>
              <div><dt>Produk diadukan</dt><dd>{d.namaProduk}</dd></div>
              <div><dt>Nomor tiket</dt><dd class="mono">{d.noTiket}</dd></div>
              <div><dt>Tgl pengaduan</dt><dd>{d.tglPengaduan}</dd></div>
              <div><dt>Kronologi</dt><dd>{d.kronologi}</dd></div>
              <div><dt>Kelengkapan</dt><dd>{d.kelengkapan}</dd></div>
            </dl>
          </section>

          <section class="panel card">
            <h2>Pelapor dan Percakapan</h2>
            <dl>
              <div><dt>Nama pelapor</dt><dd>{d.namaPelapor}</dd></div>
              <div><dt>Waktu masuk</dt><dd>{d.tglTerbit}</dd></div>
              <div><dt>Status</dt><dd>{d.labelStatus}</dd></div>
            </dl>
            <div class="kontak" data-name="KontakPelapor" data-tiket={d.noTiket} data-jenis={jenisKontak} data-no={kontak?.noTelp ?? ''} data-petugas={petugas?.nama ?? ''}>
              <span class="kontak-label">Nomor telepon pelapor</span>
              <strong class="kontak-nomor mono">{kontak ? tampilNomor(kontak.noTelp) : d.noTelp}</strong>
              {kontak && (
                <div class="kontak-aksi">
                  {tautanWa && <a class="btn-primary wa" data-name="ChatWhatsApp" href={tautanWa} target="_blank" rel="noopener noreferrer"><i class="icon-message-circle"></i>Chat WhatsApp</a>}
                  {tautanTel && <a class="pill" href={tautanTel}><i class="icon-phone"></i>Telepon</a>}
                  <button type="button" class="pill" data-salin><i class="icon-copy"></i><span>Salin</span></button>
                </div>
              )}
              {kontak && petugas?.noWa && (
                <p class="kontak-wa" data-name="WhatsAppPetugas">Pastikan WhatsApp yang terbuka adalah nomor Anda: <span class="mono">{tampilNomor(petugas.noWa)}</span></p>
              )}
              {kontak && (
                <p class="kontak-status" data-name="StatusKontak" data-sudah={kontak.sudahDihubungi ? '1' : ''}>
                  {kontak.sudahDihubungi ? `Sudah dihubungi${waktuDihubungi ? ` · ${waktuDihubungi}` : ''}` : 'Belum dihubungi'}
                </p>
              )}
              {kontak && !kontak.sudahDihubungi && (
                <button type="button" class="pill tandai" data-name="TandaiSudahDihubungi" hidden={!bolehTandai}><i class="icon-check"></i>Tandai sudah dihubungi</button>
              )}
              <p class="kontak-pesan" role="status" aria-live="polite"></p>
            </div>
            <span class="grow"></span>
            <a href={d.tautanTranskrip} class="btn-primary transkrip"><i class="icon-file-text"></i>Lihat Transkrip</a>
          </section>
        </div>
      </>
    ) : (
      <section class="panel empty" role="alert"><i class="icon-file-x"></i><span>{gagal}</span></section>
    )}
  </div>
</DashboardLayout>

<script>
  import { tautanWhatsApp, teksWhatsApp } from '../../lib/kontakPelapor';

  const panel = document.querySelector<HTMLElement>('[data-name="KontakPelapor"]');
  if (panel) {
    const pesan = panel.querySelector<HTMLElement>('.kontak-pesan')!;
    const tandai = panel.querySelector<HTMLButtonElement>('[data-name="TandaiSudahDihubungi"]');

    panel.querySelector<HTMLButtonElement>('[data-salin]')?.addEventListener('click', async (e) => {
      const label = (e.currentTarget as HTMLElement).querySelector('span')!;
      try {
        await navigator.clipboard.writeText(panel.dataset.no || '');
        label.textContent = 'Tersalin';
      } catch {
        label.textContent = 'Gagal menyalin';
      }
      setTimeout(() => { label.textContent = 'Salin'; }, 2000);
    });

    // Tanggapan disimpan tanpa memuat ulang halaman: pesan WhatsApp beralih ke tanggapan resmi dan tombol tandai muncul
    // (StepperPenanganan mengirim event ini setelah server menyimpan tanggapan).
    document.addEventListener('sigap:tanggapan-tersimpan', (e) => {
      const tanggapan = (e as CustomEvent<{ tanggapan?: string }>).detail?.tanggapan ?? '';
      const wa = panel.querySelector<HTMLAnchorElement>('[data-name="ChatWhatsApp"]');
      const tautan = tautanWhatsApp(panel.dataset.no, teksWhatsApp({ jenis: 'pengaduan', noTiket: panel.dataset.tiket || '', kirimTanggapan: true, tanggapan, petugas: panel.dataset.petugas }));
      if (wa && tautan) wa.href = tautan;
      if (tandai) tandai.hidden = false;
    });

    tandai?.addEventListener('click', async () => {
      tandai.disabled = true;
      try {
        const res = await fetch(`/api/pengaduan/${encodeURIComponent(panel.dataset.tiket || '')}/dihubungi`, { method: 'POST' });
        const d = await res.json().catch(() => null);
        if (!res.ok || d?.status === 'error') throw new Error(d?.message);
        window.location.reload();
      } catch (galat) {
        tandai.disabled = false;
        pesan.textContent = (galat as Error).message || 'Terjadi kesalahan pada sistem.';
      }
    });
  }
</script>

<style>
  .page { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 20px; overflow-y: auto; padding-right: 4px; padding-bottom: 24px; }
  .grow { flex: 1; }
  .back { align-self: flex-start; }
  .head { padding: 22px 28px; display: flex; align-items: center; gap: 16px; }
  .head-title { flex: 1; display: flex; flex-direction: column; gap: 4px; }
  .eyebrow { font-size: 13px; font-weight: 600; letter-spacing: .12em; color: var(--muted); }
  .head h1 { margin: 0; font-size: 32px; font-weight: 500; letter-spacing: -.01em; }
  .chip.big { font-size: 15px; padding: 8px 16px; }
  .grid { min-height: 0; display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 20px; }
  .card { padding: 24px 28px; display: flex; flex-direction: column; gap: 16px; }
  .card h2 { margin: 0; font-size: 24px; font-weight: 400; letter-spacing: -.01em; }
  .ringkasan { margin: 0; font-size: 18px; line-height: 1.5; text-wrap: pretty; }
  dl { margin: 0; display: flex; flex-direction: column; gap: 10px; }
  dl div { display: flex; justify-content: space-between; gap: 16px; padding: 12px 16px; border-radius: 16px; background: var(--surface); border: 1px solid var(--line); font-size: 15px; }
  dt { color: var(--muted); }
  dd { margin: 0; font-weight: 500; text-align: right; }
  .kontak { display: flex; flex-direction: column; gap: 10px; padding: 16px; border-radius: 16px; background: var(--surface); border: 2px solid var(--blue); }
  .kontak-label { font-size: 13px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .kontak-nomor { font-size: 28px; font-weight: 600; letter-spacing: .02em; }
  .kontak-aksi { display: flex; flex-wrap: wrap; gap: 8px; }
  .kontak-aksi .pill, .kontak .tandai { height: 44px; font-size: 14px; }
  .wa { height: 44px; padding: 0 18px; font-size: 14px; }
  .kontak-status { margin: 0; font-size: 14px; font-weight: 500; color: var(--danger); }
  .kontak-status[data-sudah="1"] { color: var(--muted); }
  .kontak .tandai { align-self: flex-start; }
  .kontak-wa { margin: 0; font-size: 13px; color: var(--muted); }
  .kontak-pesan { margin: 0; font-size: 14px; color: var(--danger); }
  .kontak-pesan:empty { display: none; }
  .transkrip { height: 50px; padding: 0 22px; font-size: 15px; align-self: flex-start; }
  .empty { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; font-size: 18px; color: var(--ink-3); }
  .empty i { font-size: 32px; color: var(--muted-2); }
</style>
