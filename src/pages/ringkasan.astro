---
// Boundary UC-04 Memantau Layanan, halaman Ringkasan Layanan (REQ-4.1, T-F5.1-02).
import DashboardLayout from '../layouts/DashboardLayout.astro';
import Orb from '../components/Orb.astro';
import { KB_TOTAL, chip } from '../lib/data';
import { pemantauanLayanan } from '../lib/pemantauan';
import { PESAN_PEMANTAUAN, sapaan } from '../lib/PemantauanLayananController';
import { BasisPengetahuanController } from '../lib/BasisPengetahuanController';
import { PenyimpananMateriSupabase } from '../lib/penyimpananMateriSupabase';
import { bacaKonfigurasiSupabase } from '../lib/konfigurasiSupabase';

const PERIODE = [
  ['harian', 'Harian', 'Panggilan masuk hari ini per jam'],
  ['mingguan', 'Mingguan', 'Panggilan masuk yang ditangani AI dan petugas · 7 hari terakhir'],
  ['bulanan', 'Bulanan', 'Panggilan masuk per hari · bulan ini'],
] as const;
const AWAL = 'mingguan';
// Label sumbu grafik beban paling banyak sekian, agar 24 jam atau 31 hari tidak saling tumpuk.
const LABEL_SUMBU_MAKS = 8;

const fmt = (n: number) => n.toLocaleString('id-ID');
const konfigurasi = bacaKonfigurasiSupabase();
const token = Astro.locals.tokenAkses;
// Jumlah materi dibaca dari Supabase dengan token petugas, sama seperti halaman Basis Pengetahuan; tanpa token memakai data tiruan.
const materiTotal = async () => {
  if (!konfigurasi || !token) return KB_TOTAL.total;
  const hasil = await new BasisPengetahuanController(new PenyimpananMateriSupabase({ url: konfigurasi.url, kunciPublik: konfigurasi.kunciAnon, tokenAkses: token })).daftarMateri({ ukuran: 1 });
  return 'total' in hasil ? hasil.total : null;
};
const pemantauan = pemantauanLayanan(token);
const [ringkasan, jumlahMateri, beban, agent] = await Promise.all([
  pemantauan.ringkasanLayanan().catch(() => null),
  materiTotal().catch(() => null),
  // null juga bila view beban_panggilan_per_jam belum diterapkan di basis data.
  pemantauan.bebanPanggilan().catch(() => null),
  pemantauan.pantauAgent(),
]);
// Ringkasan gagal dimuat dibedakan dari layanan yang memang belum punya data.
const gagal = ringkasan === null;
const st = ringkasan?.statistik;
const urgent = ringkasan?.kasus ?? [];
const KATEGORI = ringkasan?.kategori ?? [];
const WARNA_KATEGORI = ['#2f6bf5', '#16a34a', '#f5b70f', '#6d4aff', '#0e9fb8', '#ef6b4a', '#8a919e'];
const totalKategori = KATEGORI.reduce((n, k) => n + k.jumlah, 0);
const maxKategori = Math.max(1, ...KATEGORI.map((k) => k.persen));
const berjalan = st?.panggilanBerjalan ?? 0;
const kinerja = ringkasan?.kinerja;
const lebarBar = (n: number) => Math.min(100, (n / Math.max(1, st?.panggilanHariIni ?? 0)) * 100);
const agentNormal = agent.komponen.every((k) => k.status === 'Normal');
const STATISTIK = [
  { label: 'Panggilan Hari Ini', value: st?.panggilanHariIni, sub: st?.panggilanHariIni ? 'Sejak 00.00 WIB' : 'Belum ada panggilan', icon: 'icon-phone-incoming', bg: '#e3ecff', fg: '#2f6bf5' },
  { label: 'Dijawab Otomatis AI', value: st?.jawabanOtomatisAi, sub: st?.jawabanOtomatisAi ? 'Selesai tanpa petugas' : 'Belum ada jawaban AI', icon: 'icon-bot', bg: '#dcf5e6', fg: '#16a34a' },
  { label: 'Tiket Eskalasi Baru', value: st?.tiketEskalasiBaru, sub: `${fmt(ringkasan?.tiketBelumDitelaah ?? 0)} belum ditelaah`, icon: 'icon-ticket', bg: '#fdf0d3', fg: '#b26b00' },
  { label: 'Pengaduan Selesai', value: st?.pengaduanSelesai, sub: 'Seluruh tiket pengaduan', icon: 'icon-circle-check', bg: '#ece7fe', fg: '#6d4aff' },
];
const namaDepan = Astro.locals.petugas!.nama.split(' ')[0];
---
<DashboardLayout title="Ringkasan Layanan">
  <div class="page">
    <div class="top-row">
      <section class="panel load" data-name="BebanPanggilan" aria-labelledby="load-title">
        <div class="load-head">
          <div class="load-title">
            <h1 class="eyebrow" id="load-title">BEBAN PANGGILAN</h1>
            {PERIODE.map(([k]) => <div class="load-total" data-periode={k} hidden={k !== AWAL}><span class="big">{beban ? fmt(beban[k].total) : '—'}</span><span class="unit">panggilan</span></div>)}
            {PERIODE.map(([k, , sub]) => <span class="muted" data-periode={k} hidden={k !== AWAL}>{sub}</span>)}
          </div>
          <div class="seg" role="group" aria-label="Periode beban panggilan">
            {PERIODE.map(([k, label]) => <button data-load={k} aria-pressed={k === AWAL ? 'true' : 'false'}>{label}</button>)}
          </div>
        </div>
        {PERIODE.map(([k]) => {
          const b = beban?.[k];
          if (!b?.total) return (
            <div class="chart empty" data-periode={k} hidden={k !== AWAL}>
              {beban ? (
                <Fragment><i class="icon-phone-incoming"></i><span>Belum ada panggilan pada periode ini.</span><span class="muted">Grafik terisi otomatis begitu penelepon menghubungi CS AI.</span></Fragment>
              ) : (
                <Fragment><i class="icon-file-x"></i><span>{PESAN_PEMANTAUAN.panggilanGagalDimuat}</span></Fragment>
              )}
            </div>
          );
          const maks = Math.max(...b.kolom.map((x) => x.total));
          const langkah = Math.ceil(b.kolom.length / LABEL_SUMBU_MAKS);
          // Kolom bertumpuk dari bawah: dijawab AI, dieskalasi, lalu sisa (berjalan, tiket terbit, status lain) abu-abu.
          return (
            <div class="chart plot" data-periode={k} hidden={k !== AWAL} aria-hidden="true">
              {b.kolom.map((x, i) => (
                <div class="col" title={`${x.label} · ${fmt(x.total)} panggilan`}>
                  <div class="area">
                    <div class="stack" style={`height:${(x.total / maks) * 100}%`}>
                      {[[x.dijawabAi, '#3b74f6'], [x.dieskalasi, '#f5b70f'], [x.total - x.dijawabAi - x.dieskalasi, '#c9ced6']].map(([n, warna]) => n ? <span style={`flex:${n};background:${warna}`}></span> : null)}
                    </div>
                  </div>
                  <span class="tick">{i % langkah === 0 ? x.label : ''}</span>
                </div>
              ))}
            </div>
          );
        })}
        <div class="legend">
          {PERIODE.map(([k]) => {
            const p = beban?.[k].puncak;
            return <span class="leg" data-periode={k} hidden={k !== AWAL}><span class="dot" style="width:8px;height:8px;background:#22c55e"></span>Puncak panggilan: {p ? `${p.label} · ${fmt(p.total)} panggilan` : '—'}</span>;
          })}
          <span class="grow"></span>
          <span class="leg"><span class="dot" style="background:#3b74f6"></span>Dijawab AI</span>
          <span class="leg"><span class="dot" style="background:#f5b70f"></span>Dieskalasi</span>
        </div>
      </section>

      <section class="panel kinerja" data-name="KinerjaAI">
        <div class="kin-head">
          <div class="kin-title"><span class="eyebrow">KINERJA AI</span><h2>Tingkat Penyelesaian</h2></div>
          <a href="/riwayat-percakapan" class="link">Lihat detail<i class="icon-chevron-right"></i></a>
        </div>
        <div class="donut-row">
          {kinerja?.persen == null ? (
            <div class="donut" style="background:#e4e7ec" role="img" aria-label="Belum ada data penyelesaian">
              <div><span>—</span><span>%</span></div>
            </div>
          ) : (
            <div class="donut" style={`background:conic-gradient(#3b74f6 ${kinerja.persen * 3.6}deg, #e4e7ec 0)`} role="img" aria-label={`Tingkat Penyelesaian ${kinerja.persen}%`}>
              <div><span>{kinerja.persen}</span><span>%</span></div>
            </div>
          )}
          {/* Saat gagal dimuat, tile panggilan berjalan di bawah sudah menampilkan pesan kamus. */}
          {kinerja && (kinerja.persen == null ? (
            <div class="donut-text"><span>Belum ada data</span><span>Persentase pertanyaan yang dijawab AI tampil setelah ada panggilan.</span></div>
          ) : (
            <div class="donut-text"><span>Selesai tanpa petugas</span><span>{fmt(kinerja.jawabanAi)} dari {fmt(st!.panggilanHariIni)} panggilan hari ini</span></div>
          ))}
        </div>
        <div class="bars">
          {([['Jawaban AI', kinerja?.jawabanAi, '#3b74f6'], ['Eskalasi petugas', kinerja?.eskalasi, '#f5b70f']] as const).map(([nama, n, warna]) => (
            <div class="bar"><div class="bar-row"><span>{nama}</span><span class="mono">{n === undefined ? '—' : fmt(n)}</span></div><div class="track">{n ? <div style={`width:${lebarBar(n)}%;background:${warna}`}></div> : null}</div></div>
          ))}
        </div>
        <span class="grow"></span>
        <a href="/panggilan-berjalan" class="tile live-link" data-name="JumlahPanggilanBerjalan"><span class={berjalan ? 'dot-live' : 'dot-idle'}></span><span class="live-text">{gagal ? PESAN_PEMANTAUAN.panggilanGagalDimuat : berjalan ? `${fmt(berjalan)} panggilan berjalan` : 'Tidak ada panggilan berjalan'}</span><span class="live-go">Lihat<i class="icon-arrow-up-right"></i></span></a>
      </section>
    </div>

    <div class="cards">
      <section class="panel card" data-name="KartuStatistikLayanan">
        <h2 class="card-title">Statistik Hari Ini</h2>
        <div class="stats">
          {STATISTIK.map((s) => (
            <div class="tile stat">
              <div class="stat-head"><span>{s.label}</span><span class="stat-icon" style={`background:${s.bg};color:${s.fg}`}><i class={s.icon}></i></span></div>
              <span class="stat-value">{s.value === undefined ? '—' : fmt(s.value)}</span>
              <span class="stat-sub">{gagal ? '—' : s.sub}</span>
            </div>
          ))}
        </div>
      </section>

      <section class="panel card urgent" data-name="DaftarKasusPerluTindakLanjut">
        <div class="urgent-head"><h2 class="card-title sm">Kasus Perlu Tindak Lanjut</h2><a href="/tiket-eskalasi" class="pill round" aria-label="Lihat semua tiket eskalasi"><i class="icon-arrow-up-right"></i></a></div>
        {gagal && <div class="empty-card" role="alert"><i class="icon-file-x"></i><span>{PESAN_PEMANTAUAN.detailGagalDimuat}</span></div>}
        {!gagal && urgent.length === 0 && <div class="empty-card"><i class="icon-circle-check"></i><span>Tidak ada kasus yang perlu ditindaklanjuti.</span></div>}
        {urgent.map((u, i) => i === 0 ? (
          <div class="case-first">
            <div class="case-row"><span class="mono case-no">{u.noTiket}</span><span class="chip" style={`background:${chip(u.status).bg};color:${chip(u.status).fg}`}>{u.status}</span><span class="grow"></span><span class="case-wait"><span></span>{u.menunggu}</span></div>
            <span class="case-ring">{u.ringkasan}</span>
            <div class="case-row"><span class="case-meta"><i class="icon-clock"></i>{u.waktu}</span><span class="case-meta"><i class="icon-tag"></i>{u.jenis}</span><span class="grow"></span><a href={`/pengaduan/detail?tiket=${u.noTiket}`} class="case-open">Buka Kasus</a></div>
          </div>
        ) : (
          <div class="tile case-rest">
            <span class="case-rest-text"><span class="mono">{u.noTiket} · {u.waktu}</span><span>{u.ringkasan}</span></span>
            <span class="chip" style={`background:${chip(u.status).bg};color:${chip(u.status).fg}`}>{u.status}</span>
            <a href={`/pengaduan/detail?tiket=${u.noTiket}`} class="case-open alt">Buka Kasus</a>
          </div>
        ))}
        <div class="fade"></div>
      </section>

      <section class="panel card">
        <div class="kat-head"><h2 class="card-title">Pertanyaan per Kategori</h2><span>7 hari terakhir · {gagal ? '—' : fmt(totalKategori)} pertanyaan</span></div>
        {gagal && <div class="empty-card" role="alert"><i class="icon-file-x"></i><span>{PESAN_PEMANTAUAN.panggilanGagalDimuat}</span></div>}
        {!gagal && KATEGORI.length === 0 && <div class="empty-card"><i class="icon-chart-column"></i><span>Belum ada pertanyaan dalam 7 hari terakhir.</span></div>}
        <div class="kat-list">
          {KATEGORI.map(({ label, persen: p }, i) => (
            <div class="kat">
              <div class="kat-row"><span>{label}</span><span class="kat-pct">{p}%</span></div>
              <div class="kat-track" role="progressbar" aria-valuenow={p} aria-valuemin="0" aria-valuemax="100" aria-label={label}><div style={`width:${(p / maxKategori) * 100}%;background:${WARNA_KATEGORI[i % WARNA_KATEGORI.length]}`}></div></div>
            </div>
          ))}
        </div>
      </section>

      <section class="panel card greet">
        <Orb size={104} />
        <span class="greet-text">Selamat {sapaan(new Date())}, {namaDepan}<br />{gagal ? PESAN_PEMANTAUAN.panggilanGagalDimuat : berjalan ? `${fmt(berjalan)} panggilan berjalan` : 'Belum ada panggilan berjalan'}</span>
        <div class="greet-actions">
          <a href="/tiket-eskalasi" class="pill sm"><i class="icon-ticket"></i>Antrean tiket</a>
          <a href="/basis-pengetahuan?tambah=1" class="pill sm"><i class="icon-plus"></i>Tambah Materi</a>
          <a href="/rekap-laporan" class="pill sm"><i class="icon-download"></i>Laporan</a>
        </div>
        <span class="grow"></span>
        <a href="/pantau-ai-agent" class="tile agent">
          <span class={agentNormal ? 'dot-live' : 'dot-idle'}></span>
          <span class="agent-text"><span>Pantau AI Agent</span><span>Basis pengetahuan · {jumlahMateri === null ? '—' : fmt(jumlahMateri)} materi</span></span>
          <i class="icon-arrow-up-right"></i>
        </a>
      </section>
    </div>
  </div>
</DashboardLayout>

<script>
  // Tab periode beban panggilan. Delegasi di document, karena isi halaman diganti saat pembaruan otomatis.
  let periode = document.querySelector<HTMLElement>('[data-load][aria-pressed="true"]')!.dataset.load!;
  function pilih(p: string) {
    periode = p;
    document.querySelectorAll<HTMLElement>('[data-load]').forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.load === p)));
    document.querySelectorAll<HTMLElement>('[data-periode]').forEach((el) => (el.hidden = el.dataset.periode !== p));
  }
  document.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('[data-load]');
    if (b) pilih(b.dataset.load!);
  });

  // Pembaruan otomatis ringkasan: halaman diambil ulang sebagai request latar (X-Sigap-Latar, tidak dihitung aktivitas
  // NFR-12), lalu isi .page diganti. Dilewati saat tab tersembunyi atau fokus keyboard berada di halaman, agar fokus tidak
  // hilang. Badge sidebar dan notifikasi baru diperbarui saat navigasi berikutnya.
  const JEDA_SEGAR_RINGKASAN_MS = 30_000;
  setInterval(async () => {
    if (document.hidden || document.querySelector('.page :focus-visible')) return;
    try {
      const r = await fetch(location.pathname, { headers: { 'X-Sigap-Latar': '1' }, cache: 'no-store' });
      if (r.redirected) return location.replace('/login');
      if (!r.ok) return;
      const baru = new DOMParser().parseFromString(await r.text(), 'text/html').querySelector('.page');
      if (!baru) return;
      document.querySelector('.page')!.replaceWith(baru);
      pilih(periode);
    } catch {
      // Galat jaringan: isi lama tetap tampil sampai jeda berikutnya.
    }
  }, JEDA_SEGAR_RINGKASAN_MS);
</script>

<style>
  .page { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 20px; }
  .grow { flex: 1; }
  h1, h2 { margin: 0; font-weight: 400; }

  .eyebrow { margin: 0; font-size: 13px; font-weight: 600; letter-spacing: .12em; color: var(--muted); }
  .muted { font-size: 15px; color: var(--muted); }
  [hidden] { display: none !important; }

  .top-row { height: 500px; flex: none; display: grid; grid-template-columns: minmax(0, 1fr) 500px; gap: 20px; }
  .load { padding: 24px 28px 20px; display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .load-head { display: flex; align-items: flex-start; gap: 16px; }
  .load-title { flex: 1; display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .load-total { display: flex; align-items: baseline; gap: 12px; }
  .big { font-size: 52px; font-weight: 500; letter-spacing: -.03em; line-height: 1.05; }
  .unit { font-size: 20px; color: var(--ink-3); }
  .delta { padding: 4px 10px; border-radius: 999px; background: #dcf5e6; color: #15803d; font-size: 14px; font-weight: 600; }
  .seg { display: flex; gap: 4px; padding: 5px; border-radius: 999px; background: #e9ebef; box-shadow: inset 0 1px 3px rgba(16, 24, 40, .08); }
  .seg button { height: 42px; padding: 0 18px; border-radius: 999px; border: 1px solid transparent; background: transparent; font-size: 15px; color: #4b5260; }
  .seg button[aria-pressed='true'] { border-color: #fff; background: var(--surface); box-shadow: 0 2px 8px rgba(16, 24, 40, .1); font-weight: 500; color: var(--ink); }
  .chart { flex: 1; min-height: 0; position: relative; }
  .plot { display: flex; gap: 4px; }
  .col { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6px; }
  .area { flex: 1; min-height: 0; display: flex; align-items: flex-end; }
  .stack { width: 100%; display: flex; flex-direction: column-reverse; gap: 2px; }
  .stack span { min-height: 2px; border-radius: 2px; }
  .stack span:last-child { border-radius: 4px 4px 2px 2px; }
  .tick { height: 16px; font-size: 12px; color: var(--muted); text-align: center; white-space: nowrap; }
  .chart.empty, .empty-card { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; text-align: center; font-size: 16px; color: var(--ink-3); border-radius: 22px; background: var(--surface); border: 1px dashed #dde0e5; }
  .chart.empty i, .empty-card i { font-size: 26px; color: var(--muted-2); }
  .empty-card { flex: 1; padding: 20px; }
  .dot-idle { width: 10px; height: 10px; flex: none; border-radius: 9px; background: #9aa1ad; }
  .dot-live { width: 10px; height: 10px; flex: none; border-radius: 9px; background: #22c55e; box-shadow: 0 0 0 4px rgba(34, 197, 94, .18); }
  .legend { display: flex; align-items: center; gap: 20px; font-size: 14.5px; color: #4b5260; }
  .leg { display: flex; align-items: center; gap: 7px; }
  .dot { width: 10px; height: 10px; border-radius: 9px; }

  .kinerja { padding: 24px 26px; display: flex; flex-direction: column; gap: 20px; }
  .kin-head { display: flex; justify-content: space-between; align-items: flex-start; }
  .kin-title { display: flex; flex-direction: column; gap: 4px; }
  .kin-title h2 { font-size: 30px; letter-spacing: -.01em; }
  .link { display: flex; align-items: center; gap: 4px; font-size: 15px; font-weight: 500; color: #2152c9; padding: 6px 0; }
  .donut-row { display: flex; align-items: center; gap: 24px; }
  .donut { width: 136px; height: 136px; flex: none; border-radius: 999px; box-shadow: 0 10px 24px rgba(47, 107, 245, .18); display: flex; align-items: center; justify-content: center; }
  .donut > div { width: 108px; height: 108px; border-radius: 999px; background: var(--surface); box-shadow: inset 0 1px 3px rgba(16, 24, 40, .08); display: flex; flex-direction: column; align-items: center; justify-content: center; }
  .donut > div span:first-child { font-size: 32px; font-weight: 500; letter-spacing: -.02em; line-height: 1; }
  .donut > div span:last-child { font-size: 13px; font-weight: 600; color: #15803d; }
  .donut-text { display: flex; flex-direction: column; gap: 6px; }
  .donut-text span:first-child { font-size: 20px; font-weight: 500; }
  .donut-text span:last-child { font-size: 15.5px; line-height: 1.5; color: var(--muted); text-wrap: pretty; }
  .bars { display: flex; flex-direction: column; gap: 16px; }
  .bar { display: flex; flex-direction: column; gap: 8px; }
  .bar-row { display: flex; justify-content: space-between; font-size: 15px; }
  .bar-row .mono { font-weight: 600; }
  .track { height: 12px; border-radius: 99px; background: #e4e7ec; box-shadow: inset 0 1px 2px rgba(16, 24, 40, .08); overflow: hidden; }
  .track div { height: 100%; border-radius: 99px; }
  .live-link { display: flex; align-items: center; gap: 12px; padding: 14px 16px; border-radius: 18px; color: var(--ink); }
  .live-text { flex: 1; font-size: 15.5px; font-weight: 500; }
  .live-go { display: flex; align-items: center; gap: 6px; font-size: 14.5px; color: #2152c9; }

  .cards { flex: 1; min-height: 0; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.22fr) minmax(0, 1fr) minmax(0, 1fr); gap: 20px; }
  .card { padding: 24px; display: flex; flex-direction: column; gap: 14px; min-height: 0; }
  .card-title { font-size: 28px; letter-spacing: -.01em; }
  .card-title.sm { font-size: 24px; white-space: nowrap; }
  .stats { flex: 1; display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; gap: 12px; }
  .stat { border-radius: 20px; padding: 14px 16px; display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .stat-head { display: flex; align-items: center; justify-content: space-between; gap: 6px; font-size: 13.5px; color: #4b5260; line-height: 1.25; }
  .stat-icon { width: 32px; height: 32px; flex: none; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 15px; }
  .stat-value { font-size: 34px; font-weight: 500; letter-spacing: -.02em; margin-top: auto; }
  .stat-sub { font-size: 13px; color: #4b5260; }

