<style>
  .ph { margin: 20px; height: calc(100% - 40px); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; color: var(--muted); }
  .ph h1 { margin: 0; font-size: 40px; font-weight: 400; color: var(--ink); }
  .ph p { margin: 0 0 8px; font-size: 17px; }
</style>
