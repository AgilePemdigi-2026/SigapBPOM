---
// Boundary UC-07 Mengelola Basis Pengetahuan (REQ-7.1 sampai REQ-7.4, BR-4, BR-5).
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { KATEGORI_MATERI, chip } from '../lib/data';
import { PESAN_MATERI, UKURAN_HALAMAN_BAWAAN, type Materi } from '../lib/BasisPengetahuanController';
import { basisPengetahuan } from '../lib/basisPengetahuan';

const basis = basisPengetahuan(Astro.locals.tokenAkses);
const [daftar, graf] = await Promise.all([basis.semuaMateri(), basis.grafPengetahuan()]);
const MATERI: Materi[] = 'materi' in daftar ? daftar.materi : [];
const gagal = 'gagal' in daftar ? daftar.gagal : '';
const SIMPUL = 'simpul' in graf ? graf.simpul : [];
const SISI = 'sisi' in graf ? graf.sisi : [];
const gagalGraf = 'gagal' in graf ? graf.gagal : '';
const aktif = MATERI.filter((m) => m.aktif).length;
const KB_TOTAL = { total: MATERI.length, aktif, nonaktif: MATERI.length - aktif };

const awal = SIMPUL[0];
const byId = Object.fromEntries(SIMPUL.map((n) => [n.id, n]));
const data = {
  materi: MATERI,
  total: KB_TOTAL,
  gagal,
  pesan: PESAN_MATERI,
  ukuran: UKURAN_HALAMAN_BAWAAN,
  simpul: SIMPUL,
  chipAktif: chip('Aktif'),
  chipNonaktif: chip('Tidak Aktif'),
};
---
<DashboardLayout title="Basis Pengetahuan">
  <div class="page">
    <section class="panel head">
      <div class="head-title"><h1>Basis Pengetahuan</h1><span><span data-total>{KB_TOTAL.total.toLocaleString('id-ID')}</span> materi · {KB_TOTAL.total ? 'diperbarui dari basis data' : 'belum ada pembaruan'}</span></div>
      <span class="search"><i class="icon-search"></i><input id="kb-q" placeholder="Cari judul materi atau rujukan sumber…" aria-label="Cari judul materi atau rujukan sumber" /></span>
      <button class="tab big" data-view="list" aria-pressed="true"><i class="icon-list"></i>Daftar Materi</button>
      <button class="tab big" data-view="graph" aria-pressed="false"><i class="icon-waypoints"></i>Graf Pengetahuan</button>
      <button class="btn-primary add" id="open-add"><i class="icon-plus"></i>Tambah Materi</button>
    </section>

    <div class="view-list" id="view-list">
      <section class="panel list">
        <div class="filters" role="group" aria-label="Filter status">
          <button class="tab" data-tab="Semua" aria-pressed="true">Semua</button>
          <button class="tab" data-tab="Aktif" aria-pressed="false">Aktif</button>
          <button class="tab" data-tab="Tidak Aktif" aria-pressed="false">Tidak Aktif</button>
        </div>
        <div class="row-grid cols-head" aria-hidden="true"><span>JUDUL MATERI</span><span>RUJUKAN SUMBER</span><span>PEMUTAKHIRAN</span><span>STATUS</span><span>AKSI</span></div>
        <div class="rows" id="kb-rows"></div>
        <div class="empty" id="kb-empty" hidden><i class="icon-book-open"></i><span id="kb-empty-text">Belum ada materi yang cocok.</span><button class="pill" id="empty-add"><i class="icon-plus"></i>Tambah Materi</button></div>
        <div class="list-foot">
          <span class="shown">Menampilkan <span id="kb-shown">0</span> dari <span id="kb-cocok">{KB_TOTAL.total.toLocaleString('id-ID')}</span> materi</span>
          <span class="pager" id="kb-pager" hidden>
            <button class="tab ikon" data-hal="-1" aria-label="Halaman sebelumnya"><i class="icon-chevron-left"></i></button>
            <span id="kb-hal"></span>
            <button class="tab ikon" data-hal="1" aria-label="Halaman berikutnya"><i class="icon-chevron-right"></i></button>
          </span>
        </div>
      </section>

      <aside class="side-col">
        <section class="panel index">
          <h2>Indeks Pengetahuan</h2>
          <span class="index-total"><span data-total>{KB_TOTAL.total.toLocaleString('id-ID')}</span><span>materi</span></span>
          <div class="index-split">
            <div class="tile-flat"><span>Aktif</span><span class="v ok" id="kb-aktif">{KB_TOTAL.aktif.toLocaleString('id-ID')}</span></div>
            <div class="tile-flat"><span>Tidak aktif</span><span class="v" id="kb-nonaktif">{KB_TOTAL.nonaktif.toLocaleString('id-ID')}</span></div>
            <div class="tile-flat wide"><span>Pemutakhiran</span><span class="v" id="kb-tgl">{MATERI[0]?.tgl ?? '–'}</span></div>
          </div>
        </section>
        <section class="panel rules">
          <h2>Aturan materi</h2>
          <span><i class="icon-link"></i>Setiap materi wajib punya rujukan sumber.</span>
          <span><i class="icon-archive"></i>Materi usang dinonaktifkan, tidak dihapus permanen, dan tidak lagi dipakai sebagai sumber jawaban.</span>
        </section>
      </aside>
    </div>

    <div class="view-graph" id="view-graph" hidden>
      <section class="panel graph" data-name="GrafPengetahuan">
        <div class="graph-head"><h2>Graf Pengetahuan</h2><span>Pilih simpul untuk melihat rujukan dan bagian dokumen terindeks</span></div>
        <div class="canvas" id="graf-canvas">
          <div class="zoom">
            <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
              {SISI.map(([a, b]) => (
                <line x1={byId[a].x} y1={byId[a].y} x2={byId[b].x} y2={byId[b].y} data-a={a} data-b={b} vector-effect="non-scaling-stroke" />
              ))}
            </svg>
            {SIMPUL.map((n) => (
              <button class:list={['node', { hub: n.hub }]} data-node={n.id} aria-pressed={n.id === awal?.id ? 'true' : 'false'} style={`left:${n.x}%;top:${n.y}%;width:${n.r * 2}px;height:${n.r * 2}px`}>{n.label}</button>
            ))}
          </div>
        </div>
        <div class="graph-foot">
          <span class="legend"><span class="sw hub"></span>Topik</span>
          <span class="legend"><span class="sw"></span>Materi edukasi</span>
          <span class="grow"></span>
          <button class="tab ikon" data-zoom="-1" aria-label="Perkecil graf" disabled><i class="icon-zoom-out"></i></button>
          <button class="tab ikon" data-zoom="1" aria-label="Perbesar graf"><i class="icon-zoom-in"></i></button>
        </div>
      </section>
      {!awal && <div class="graph-empty"><i class="icon-waypoints"></i><span>{gagalGraf || 'Graf terbentuk setelah ada materi di basis pengetahuan.'}</span></div>}
      {awal && <section class="panel detail" data-name="BagianDokumenTerindeks" aria-live="polite">
        <span class="eyebrow">SIMPUL TERPILIH</span>
        <span class="detail-title" id="node-label">{awal.label}</span>
        <div class="index-split" id="node-meta" hidden>
          <div class="tile-flat"><span>Status</span><span id="node-status"></span></div>
          <div class="tile-flat"><span>Pemutakhiran</span><span class="v" id="node-tgl"></span></div>
        </div>
        <div class="tile-flat ruj"><span>Rujukan Sumber</span><span class="ruj-v"><i class="icon-link"></i><span id="node-rujukan">{awal.rujukan}</span></span></div>
        <span class="bagian-title">Bagian dokumen terindeks</span>
        <div id="node-bagian" class="bagian"></div>
        <span class="grow"></span>
        <span class="links"><i class="icon-waypoints"></i>Terhubung ke <span id="node-links">{awal.links}</span> materi lain</span>
      </section>}
    </div>
  </div>

  <dialog id="add-dialog" class="modal" aria-labelledby="add-title">
    <form id="add-form" data-name="FormulirMateri" method="dialog" novalidate>
      <div class="modal-head"><h2 id="add-title">Tambah Materi</h2><button type="button" class="x" data-close aria-label="Tutup"><i class="icon-x"></i></button></div>
      <label class="f"><span>Judul Materi</span><input name="judul" placeholder="mis. Cara membaca tanggal kedaluwarsa" /></label>
      <label class="f"><span>Kategori</span><select name="kategori">{KATEGORI_MATERI.map((k) => <option>{k}</option>)}</select></label>
      <label class="f"><span>Isi Materi</span><textarea name="isi" placeholder="Tempel atau tulis isi materi edukasi…"></textarea></label>
      <label class="f"><span>Rujukan Sumber</span><input name="rujukan" placeholder="mis. KataBPOM, Peraturan BPOM, Public Warning" aria-describedby="add-err" /></label>
      <span class="ferr" id="add-err" role="alert" hidden><i class="icon-circle-alert"></i><span id="add-err-text">Rujukan sumber wajib diisi.</span></span>
      <div class="modal-actions">
        <button type="button" class="pill" data-close>Batal</button>
        <button type="submit" class="btn-primary save" id="save-btn" aria-disabled="true">Simpan</button>
      </div>
    </form>
  </dialog>

  <script type="application/json" id="kb-data" set:html={JSON.stringify(data)} />
</DashboardLayout>

<script>
  type Materi = { id: number | string; judul: string; kategori: string; rujukan: string; tgl: string; aktif: boolean };
  type Simpul = { id: string; label: string; rujukan: string; bagian: string[]; links: number };
  const D = JSON.parse(document.getElementById('kb-data')!.textContent!);
  const materi: Materi[] = D.materi;
  const toast = (msg: string, kind?: 'err') => (window as any).sigapToast?.(msg, kind);
  const fmt = (n: number) => n.toLocaleString('id-ID');
  const hariIni = () => new Intl.DateTimeFormat('id-ID', { timeZone: 'Asia/Jakarta', day: '2-digit', month: 'short', year: 'numeric' }).format(new Date()).replace('.', '');
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const chipStatus = (m: Materi) => {
    const c = m.aktif ? D.chipAktif : D.chipNonaktif;
    return `<span class="chip" style="background:${c.bg};color:${c.fg}">${m.aktif ? 'Aktif' : 'Tidak Aktif'}</span>`;
  };
  const st = { tab: 'Semua', q: '', halaman: 1, added: 0, deact: 0 };

  const rowsEl = document.getElementById('kb-rows')!;
  function render() {
    const q = st.q.trim().toLowerCase();
    const list = materi.filter((m) => (st.tab === 'Semua' || (st.tab === 'Aktif') === m.aktif) && (!q || `${m.judul} ${m.rujukan}`.toLowerCase().includes(q)));
    // F2.1: paginasi di browser atas materi yang sudah dimuat (lihat bacaSemua di BasisPengetahuanController).
    const jumlahHal = Math.max(1, Math.ceil(list.length / D.ukuran));
    st.halaman = Math.min(st.halaman, jumlahHal);
    const tampil = list.slice((st.halaman - 1) * D.ukuran, st.halaman * D.ukuran);
    rowsEl.innerHTML = tampil.map((m) => `<div class="row row-grid${m.aktif ? '' : ' off'}">
        <span class="judul"><span>${esc(m.judul)}</span><span>${esc(m.kategori)}</span></span>
        <span class="ruj-cell"><i class="icon-link"></i><span>${esc(m.rujukan)}</span></span>
        <span class="tgl">${esc(m.tgl)}</span>
        ${chipStatus(m)}
        ${m.aktif ? `<button class="hapus" data-id="${m.id}" aria-label="Hapus ${esc(m.judul)}">Hapus</button>` : '<span class="arsip">Diarsipkan</span>'}
      </div>`).join('');
    document.getElementById('kb-shown')!.textContent = String(tampil.length);
    document.getElementById('kb-cocok')!.textContent = fmt(list.length);
    document.getElementById('kb-pager')!.hidden = jumlahHal <= 1;
    document.getElementById('kb-hal')!.textContent = `${st.halaman} / ${jumlahHal}`;
    document.querySelectorAll<HTMLButtonElement>('[data-hal]').forEach((b) => (b.disabled = b.dataset.hal === '1' ? st.halaman >= jumlahHal : st.halaman <= 1));
    document.getElementById('kb-empty')!.hidden = list.length > 0;
    document.getElementById('kb-empty-text')!.textContent = D.gagal || (materi.length ? 'Belum ada materi yang cocok.' : 'Belum ada materi. Tambahkan materi pertama.');
    document.querySelectorAll('[data-total]').forEach((el) => (el.textContent = fmt(D.total.total + st.added)));
    document.getElementById('kb-aktif')!.textContent = fmt(D.total.aktif + st.added - st.deact);
    document.getElementById('kb-nonaktif')!.textContent = fmt(D.total.nonaktif + st.deact);
  }

  function pressGroup(attr: string, value: string) {
    document.querySelectorAll<HTMLElement>(`[${attr}]`).forEach((b) => b.setAttribute('aria-pressed', String(b.getAttribute(attr) === value)));
  }

  document.querySelectorAll<HTMLElement>('[data-tab]').forEach((b) => b.addEventListener('click', () => { st.tab = b.dataset.tab!; st.halaman = 1; pressGroup('data-tab', st.tab); render(); }));
  (document.getElementById('kb-q') as HTMLInputElement).addEventListener('input', (e) => { st.q = (e.target as HTMLInputElement).value; st.halaman = 1; showView('list'); render(); });
  document.querySelectorAll<HTMLElement>('[data-hal]').forEach((b) => b.addEventListener('click', () => { st.halaman += Number(b.dataset.hal); render(); rowsEl.scrollTop = 0; }));

  // REQ-7.3, BR-5: nonaktifkan, tidak menghapus permanen.
  rowsEl.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('.hapus');
    if (!btn) return;
    const m = materi.find((x) => x.id === btn.dataset.id)!;
    if (!confirm(`Tandai "${m.judul}" tidak aktif? Materi tidak dihapus permanen, tetapi tidak lagi dipakai sebagai sumber jawaban.`)) return;
    btn.setAttribute('aria-disabled', 'true');
    const res = await fetch(`/api/materi/${encodeURIComponent(m.id)}/nonaktifkan`, { method: 'POST' }).catch(() => null);
    const hasil = await res?.json().catch(() => null);
    if (!res?.ok) {
      btn.removeAttribute('aria-disabled');
      // Pesan API (mis. "Akses ditolak." dari middleware) tidak ada di kamus, jadi tidak ditampilkan ke petugas.
      return toast(D.pesan.gagalDinonaktifkan, 'err');
    }
    // Basis data mencatat waktu penonaktifan sebagai pemutakhiran.
    m.aktif = false;
    m.tgl = hariIni();
    document.getElementById('kb-tgl')!.textContent = m.tgl;
    st.deact++;
    render();
    toast(hasil.message);
  });

  function showView(v: 'list' | 'graph') {
    document.getElementById('view-list')!.hidden = v !== 'list';
    document.getElementById('view-graph')!.hidden = v !== 'graph';
    pressGroup('data-view', v);
  }
  document.querySelectorAll<HTMLElement>('[data-view]').forEach((b) => b.addEventListener('click', () => showView(b.dataset.view as 'list' | 'graph')));

  // REQ-7.4: graf pengetahuan.
  const simpul: Record<string, Simpul> = Object.fromEntries(D.simpul.map((n: Simpul) => [n.id, n]));
  function pilih(id: string) {
    const n = simpul[id];
    pressGroup('data-node', id);
    document.querySelectorAll<SVGLineElement>('.canvas line').forEach((l) => l.classList.toggle('hot', l.dataset.a === id || l.dataset.b === id));
    // F2.4: detail simpul materi sesuai isi tabel, dengan judul utuh, status, dan pemutakhiran.
    const m = materi.find((x) => x.id === id);
    document.getElementById('node-label')!.textContent = m?.judul ?? n.label;
    document.getElementById('node-meta')!.hidden = !m;
    if (m) {
      document.getElementById('node-status')!.innerHTML = chipStatus(m);
      document.getElementById('node-tgl')!.textContent = m.tgl;
    }
    document.getElementById('node-rujukan')!.textContent = n.rujukan;
    document.getElementById('node-links')!.textContent = String(n.links);
    document.getElementById('node-bagian')!.innerHTML = n.bagian.length
      ? n.bagian.map((b) => `<div class="tile-flat"><i class="icon-file-text"></i>${esc(b)}</div>`).join('')
      : '<div class="tile-flat kosong">Belum ada bagian dokumen terindeks.</div>';
  }
  document.querySelectorAll<HTMLElement>('[data-node]').forEach((b) => b.addEventListener('click', () => pilih(b.dataset.node!)));
  if (D.simpul.length) pilih(D.simpul[0].id);

  // F2.4, T-F2.4-01: zoom merenggangkan jarak antarsimpul dan kanvas bisa digulir; ukuran simpul tetap agar label terbaca.
  const ZOOM_MIN = 1;
  const ZOOM_MAKS = 3;
  const ZOOM_LANGKAH = 0.5;
  const kanvas = document.getElementById('graf-canvas')!;
  const tombolZoom = document.querySelectorAll<HTMLButtonElement>('[data-zoom]');
  let zoom = ZOOM_MIN;
  tombolZoom.forEach((b) => b.addEventListener('click', () => {
    const baru = Math.min(ZOOM_MAKS, Math.max(ZOOM_MIN, zoom + Number(b.dataset.zoom) * ZOOM_LANGKAH));
    // Titik di tengah tampilan tetap di tengah setelah zoom.
    const cx = (kanvas.scrollLeft + kanvas.clientWidth / 2) * (baru / zoom);
    const cy = (kanvas.scrollTop + kanvas.clientHeight / 2) * (baru / zoom);
    zoom = baru;
    kanvas.style.setProperty('--z', String(zoom));
    kanvas.scrollTo(cx - kanvas.clientWidth / 2, cy - kanvas.clientHeight / 2);
    tombolZoom.forEach((t) => (t.disabled = t.dataset.zoom === '1' ? zoom >= ZOOM_MAKS : zoom <= ZOOM_MIN));
  }));

  // REQ-7.1, REQ-7.2, BR-4: tambah materi.
  const dialog = document.getElementById('add-dialog') as HTMLDialogElement;
  const form = document.getElementById('add-form') as HTMLFormElement;
  const err = document.getElementById('add-err')!;
  const errTeks = document.getElementById('add-err-text')!;
  const saveBtn = document.getElementById('save-btn')!;
  const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement;

  function bukaTambah() { form.reset(); err.hidden = true; field('rujukan').classList.remove('invalid'); saveBtn.setAttribute('aria-disabled', 'true'); dialog.showModal(); field('judul').focus(); }
  document.getElementById('open-add')!.addEventListener('click', bukaTambah);
  document.getElementById('empty-add')!.addEventListener('click', bukaTambah);
  dialog.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', () => dialog.close()));
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  field('judul').addEventListener('input', () => saveBtn.setAttribute('aria-disabled', String(!field('judul').value.trim())));
  field('rujukan').addEventListener('input', () => { err.hidden = true; field('rujukan').classList.remove('invalid'); });

  // Simpan menulis ke basis data dan menunggu embedding; klik kedua atau Enter selama menunggu tidak boleh membuat materi ganda.
  let mengirim = false;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (mengirim) return;
    const judul = field('judul').value.trim();
    const rujukan = field('rujukan').value.trim();
    if (!judul) return field('judul').focus();
    if (!rujukan) { errTeks.textContent = 'Rujukan sumber wajib diisi.'; err.hidden = false; field('rujukan').classList.add('invalid'); field('rujukan').focus(); return; }
    const kategori = field('kategori').value;
    const isi = field('isi').value;

    mengirim = true;
    saveBtn.setAttribute('aria-disabled', 'true');
    // Lewat proxy same-origin, yang melampirkan token sesi petugas dari cookie HttpOnly (src/pages/api/simpan-materi.ts).
    const respon = await fetch('/api/simpan-materi', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ judul, rujukan, kategori, isi }),
    }).catch(() => null);
    const hasil = await respon?.json().catch(() => null);
    mengirim = false;
    saveBtn.removeAttribute('aria-disabled');
    if (!respon?.ok || hasil?.status === 'error') {
      // REQ-7.1: jangan tampilkan sukses bila server tidak menyimpan materi. Dialog tetap terbuka agar isian tidak hilang.
      // Pesan API internal ("Akses ditolak.", "Permintaan tidak valid.") tidak ada di kamus, jadi tidak ditampilkan.
      const rujukanKosong = respon?.status === 422;
      // Pesan server (mis. "Akses ditolak.") tidak ditampilkan apa adanya; 422 hanya dipakai untuk rujukan kosong.
      errTeks.textContent = rujukanKosong ? 'Rujukan sumber wajib diisi.' : D.pesan.gagalDisimpan;
      err.hidden = false;
      field('rujukan').classList.toggle('invalid', rujukanKosong);
      return;
    }
    materi.unshift({ id: hasil?.data?.id || Date.now(), judul, kategori, rujukan, tgl: hariIni(), aktif: true });
    document.getElementById('kb-tgl')!.textContent = materi[0].tgl;
    st.added++;
    st.tab = 'Semua'; st.q = ''; st.halaman = 1;
    (document.getElementById('kb-q') as HTMLInputElement).value = '';
    pressGroup('data-tab', 'Semua');
    showView('list');
    render();
    dialog.close();
    toast(hasil?.message || 'Materi siap digunakan sistem.');
  });

  render();
  if (new URLSearchParams(location.search).has('tambah')) bukaTambah();
</script>

<style>
  .page { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 20px; }
  .grow { flex: 1; }
  h1, h2 { margin: 0; font-weight: 400; }
  [hidden] { display: none !important; }

  .head { flex: none; padding: 20px 22px 20px 28px; display: flex; align-items: center; gap: 10px; }
  .head-title { display: flex; flex-direction: column; gap: 3px; margin-right: 16px; }
  .head-title h1 { font-size: 40px; letter-spacing: -.02em; white-space: nowrap; }
  .head-title > span { font-size: 15px; color: var(--muted); white-space: nowrap; }
  .search { flex: 1; min-width: 160px; display: flex; align-items: center; gap: 12px; height: 54px; padding: 0 20px; border-radius: 999px; background: var(--surface); border: 1px solid var(--line); box-shadow: inset 0 1px 2px rgba(16, 24, 40, .04); }
  .search i { color: var(--muted-2); font-size: 18px; }
  .search input { flex: 1; min-width: 0; border: 0; outline: none; background: transparent; font-size: 16px; }
  .tab.big { height: 54px; padding: 0 18px; white-space: nowrap; }
  .add { height: 54px; padding: 0 22px; font-size: 15.5px; white-space: nowrap; }

  .view-list { flex: 1; min-height: 0; display: grid; grid-template-columns: minmax(0, 1fr) 420px; gap: 20px; }
  .list { padding: 22px 24px; display: flex; flex-direction: column; gap: 14px; min-height: 0; }
  .filters { display: flex; gap: 8px; }
  .list :global(.row-grid) { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr) 150px 130px 110px; gap: 16px; align-items: center; padding: 0 20px; }
  .cols-head { font-size: 12.5px; font-weight: 600; letter-spacing: .1em; color: var(--muted); }
  .rows { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 8px; overflow-y: auto; }
  .shown { font-size: 15px; color: var(--muted); }
  .list-foot, .pager { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .pager { font-size: 15px; color: var(--muted); }
