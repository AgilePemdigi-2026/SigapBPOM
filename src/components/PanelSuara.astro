---
// Boundary UC-01/UC-02: panel percakapan suara "CS AI HaloBPOM" (REQ-1.1, REQ-1.2, REQ-2.1, REQ-2.4, REQ-2.5).
// Dibuka lewat event `sigap:buka-panggilan`. Suara penelepon direkam di browser lalu dikirim ke
// Voice Gateway (/voice) yang meneruskannya ke ElevenLabs STT, Hermes Agent, dan ElevenLabs TTS.
interface Props { mode: 'desktop' | 'mobile' }
const { mode } = Astro.props;
const bars = [0.5, 0.9, 0.6, 1, 0.7, 0.4, 0.85, 0.55, 0.95, 0.5, 0.7, 0.45];
---
<div class:list={['panel-wrap', mode]} data-panel={mode} hidden>
  {mode === 'desktop' && <div class="dim" data-close></div>}
  <section class="panel-suara" role="dialog" aria-modal="true" aria-label="Panel percakapan suara CS AI HaloBPOM">
    <div class="ps-head">
      <div class="ps-orb" aria-hidden="true"></div>
      <div class="ps-id"><div class="ps-name">CS AI HaloBPOM</div><div class="ps-sub">Asisten suara resmi · SIGAP</div></div>
      <button class="ps-min" data-close title="Perkecil" aria-label="Perkecil panel"><i class="icon-minus"></i></button>
    </div>
    <div class="ps-status">
      <span class="ps-dot" data-dot></span>
      <span class="ps-state" data-state>MENYAMBUNGKAN</span>
      <span class="ps-wave" aria-hidden="true">{bars.map((h, i) => <span style={`height:${20 * h}px;animation-duration:${0.7 + (i % 4) * 0.15}s;animation-delay:${i * 0.06}s`}></span>)}</span>
      <span class="grow"></span>
      <span class="ps-dur-label">DURASI</span>
      <span class="ps-dur mono" data-dur>00:00</span>
    </div>
    <div class="ps-service" data-service hidden>
      <div class="ps-service-no" data-service-no>1</div>
      <div class="ps-service-text"><span>LAYANAN DIPILIH</span><span data-service-name>Informasi Produk</span></div>
      <button class="ps-ganti" data-ganti>Ganti</button>
    </div>
    <div class="ps-tr-head">
      <span>TRANSKRIP LANGSUNG</span>
      <span class="ps-saved"><i class="icon-check"></i>{mode === 'mobile' ? 'tersimpan' : 'tersimpan di register layanan'}</span>
    </div>
    <div class="ps-tr" data-tr role="log" aria-live="polite" aria-label="Transkrip langsung"></div>
    <button class="ps-end" data-end><i class="icon-phone-off"></i>Akhiri Panggilan</button>
    <div class="ps-after" data-after hidden>
      <button class="ps-restart" data-restart><i class="icon-phone"></i>Telepon CS AI</button>
      <button class="ps-close" data-close>Tutup</button>
    </div>
  </section>
</div>

<script>
  import { esc, htmlKartuEskalasi, htmlKartuProduk, type HasilProduk } from '../lib/kartuPanggilan';

  type Sumber = { peraturan: string; judul: string; url: string };
  type Msg = { kind: 'sys' | 'user' | 'menu' | 'processing' | 'ended'; text?: string; time?: string; sumber?: Sumber[]; produk?: HasilProduk; tiket?: string };
  type Hasil = { transkrip: string | null; jawaban: string | null; suara: string | null; akhiri?: boolean; sumber?: Sumber[]; produk?: HasilProduk; tiket?: string };

  const GATEWAY = '/voice';
  const PESAN_MENU = 'Tekan 1 untuk informasi produk, tekan 2 untuk pengaduan.'; // REQ-1.1
  // Deteksi giliran bicara sederhana dari kekuatan sinyal mikrofon.
  const AMBANG_SUARA = 0.025;
  const JEDA_SELESAI_MS = 800;
  const UCAPAN_MAKS_MS = 15_000;
  const TUNGGU_MAKS_MS = 8_000;

  // REQ-1.6 (T-F1.3-01): chip sumber rujukan di bawah jawaban agen, dibaca pembaca layar sebagai "Sumber: ...".
  function chipSumber(s: Sumber) {
    const label = esc(s.peraturan);
    const judul = esc(s.judul);
    return /^https?:\/\//.test(s.url)
      ? `<li><a href="${esc(s.url)}" target="_blank" rel="noopener" title="${judul}" aria-label="Sumber: ${label}">${label}</a></li>`
      : `<li><span title="${judul}" aria-label="Sumber: ${label}">${label}</span></li>`;
  }

  function render(m: Msg) {
    switch (m.kind) {
      case 'sys': return `<div class="m-sys"><span>CS AI · ${m.time}</span><div>${esc(m.text!)}</div>${
        m.produk ? htmlKartuProduk(m.produk) : ''}${m.tiket ? htmlKartuEskalasi(m.tiket) : ''}${
        m.sumber?.length ? `<ul class="m-sumber" aria-label="Sumber rujukan">${m.sumber.map(chipSumber).join('')}</ul>` : ''}</div>`;
      case 'user': return `<div class="m-user"><span>ANDA · ${m.time}</span><div>${esc(m.text!)}</div></div>`;
      case 'menu': return `<div class="m-menu">
        <button data-pick="1"><span class="no">1</span><span class="t">Informasi Produk</span><span class="d">Izin edar dan edukasi obat &amp; makanan</span></button>
        <button data-pick="2"><span class="no purple">2</span><span class="t">Pengaduan Produk</span><span class="d">Laporkan produk yang bermasalah</span></button></div>`;
      case 'processing': return `<div class="m-proc"><i class="icon-loader-circle"></i>${esc(m.text!)}</div>`;
      case 'ended': return `<div class="m-ended"><i class="icon-phone-off"></i><span>${esc(m.text!)}</span></div>`;
    }
  }

  function setup(root: HTMLElement) {
    const $ = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const tr = $('[data-tr]');
    let phase: 'connecting' | 'menu' | 'flow' | 'ended' = 'connecting';
    let mode: 'diam' | 'mendengar' | 'memproses' | 'berbicara' = 'diam';
    let service: 1 | 2 | null = null, secs = 0, msgs: Msg[] = [];
    let tick: number | undefined, idPanggilan = '';
    let mic: MediaStream | null = null, ctx: AudioContext | null = null, analis: AnalyserNode | null = null, rekam: MediaRecorder | null = null;
    let pantau: number | undefined;
    const pemutar = new Audio();
    // Tempo bicara gaya CS. Model TTS v3 tidak punya pengaturan kecepatan, jadi audio dipercepat di sini
    // dengan nada tetap. defaultPlaybackRate dipakai karena mengganti src mengembalikan playbackRate ke nilai itu.
    const KECEPATAN_PUTAR = 1.2;
    pemutar.defaultPlaybackRate = pemutar.playbackRate = KECEPATAN_PUTAR;
    pemutar.preservesPitch = true;

    const stamp = () => `${String(Math.floor(secs / 60)).padStart(2, '0')}:${String(secs % 60).padStart(2, '0')}`;
    const LABEL = { diam: 'TERSAMBUNG', mendengar: 'MENDENGARKAN', memproses: 'MEMPROSES', berbicara: 'BERBICARA' };

    function paint() {
      const ended = phase === 'ended', live = !ended && phase !== 'connecting';
      tr.innerHTML = msgs.map(render).join('');
      tr.scrollTop = tr.scrollHeight;
      $('[data-state]').textContent = ended ? 'BERAKHIR' : phase === 'connecting' ? 'MENYAMBUNGKAN' : LABEL[mode];
      root.classList.toggle('live', live);
      root.classList.toggle('ended', ended);
      $('[data-dur]').textContent = stamp();
      $('[data-service]').hidden = !service || ended;
      if (service) {
        $('[data-service-no]').textContent = String(service);
        $('[data-service-name]').textContent = service === 1 ? 'Informasi Produk' : 'Pengaduan Produk';
      }
      $('[data-end]').hidden = ended;
      $('[data-after]').hidden = !ended;
    }
    const push = (m: Msg) => { msgs = msgs.filter((x) => x.kind !== 'processing').concat({ ...m, time: stamp() }); paint(); };
    const say = (text: string, sumber?: Sumber[], produk?: HasilProduk, tiket?: string) => push({ kind: 'sys', text, sumber, produk, tiket });
    const setMode = (m: typeof mode) => { mode = m; paint(); };

    // Putar audio jawaban lalu kembali mendengarkan. Mikrofon tidak merekam selama agen berbicara.
    function putar(src: string) {
      return new Promise<void>((selesai) => {
        setMode('berbicara');
        pemutar.src = src;
        pemutar.onended = pemutar.onerror = () => selesai();
        pemutar.play().catch(() => selesai());
      });
    }

    // Mode demo dev server (?demo=<nama>): giliran diambil dari transkrip tiruan, bukan dari gateway suara.
    let giliranTiruan: Hasil[] | null = null;

    async function kirimGiliran(body: Blob | { pilih: number }) {
      if (giliranTiruan) return giliranTiruan.shift() ?? { transkrip: null, jawaban: null, suara: null };
      const audio = body instanceof Blob;
      const r = await fetch(audio ? `${GATEWAY}/giliran?id=${idPanggilan}` : `${GATEWAY}/giliran`, {
        method: 'POST',
        headers: { 'content-type': audio ? (body.type || 'audio/webm') : 'application/json' },
        body: audio ? body : JSON.stringify({ id: idPanggilan, ...body }),
      });
      const d = await r.json().catch(() => null);
      if (!r.ok || !d?.data) throw new Error(d?.message ?? 'Layanan suara sedang gangguan. Silakan coba lagi.');
      return d.data as Hasil;
    }

    async function prosesHasil(h: Hasil) {
      if (phase === 'ended') return;
      if (h.transkrip) push({ kind: 'user', text: h.transkrip });
      if (h.jawaban) say(h.jawaban, h.sumber, h.produk, h.tiket);
      if (h.suara) await putar(h.suara);
      // Penelepon tidak butuh bantuan lagi: tutup panggilan setelah salam penutup selesai diputar.
      if (h.akhiri) return end();
      // Mode demo tanpa mikrofon: giliran tiruan berikutnya langsung diputar.
      if (giliranTiruan?.length) return prosesHasil(giliranTiruan.shift()!);
      if (phase !== 'ended') dengar();
    }

    async function giliranSuara(rekaman: Blob) {
      setMode('memproses');
      push({ kind: 'processing', text: 'Memproses ucapan Anda' });
      try { await prosesHasil(await kirimGiliran(rekaman)); } catch (e) { gagal(e); }
    }

    function gagal(e: unknown) {
      if (phase === 'ended') return;
      say(e instanceof Error ? e.message : 'Layanan suara sedang gangguan. Silakan coba lagi.');
      dengar();
    }

    function berhentiRekam() {
      clearInterval(pantau);
      pantau = undefined;
      if (rekam && rekam.state !== 'inactive') { rekam.ondataavailable = null; rekam.onstop = null; rekam.stop(); }
      rekam = null;
    }

    // Rekam satu ucapan: mulai saat sinyal melewati ambang, berhenti setelah jeda hening.
    function dengar() {
      berhentiRekam();
      if (phase === 'ended' || phase === 'connecting' || !mic || !ctx || !analis) { setMode('diam'); return; }
      setMode('mendengar');
      ctx.resume().catch(() => {});
      const a = analis;
      const sampel = new Float32Array(a.fftSize);
      const tipe = ['audio/webm;codecs=opus', 'audio/mp4', 'audio/ogg;codecs=opus'].find((t) => MediaRecorder.isTypeSupported(t));
      const r = new MediaRecorder(mic, tipe ? { mimeType: tipe } : undefined);
      const potongan: Blob[] = [];
      const mulai = Date.now();
      let bicaraSejak = 0, heningSejak = 0;
      r.ondataavailable = (e) => { if (e.data.size) potongan.push(e.data); };
      r.onstop = () => {
        if (rekam === r) rekam = null;
        if (bicaraSejak) giliranSuara(new Blob(potongan, { type: r.mimeType }));
        else dengar();
      };
      r.start(250);
      rekam = r;
      pantau = window.setInterval(() => {
        a.getFloatTimeDomainData(sampel);
        const rms = Math.sqrt(sampel.reduce((n, x) => n + x * x, 0) / sampel.length);
        const t = Date.now();
        if (rms > AMBANG_SUARA) { if (!bicaraSejak) bicaraSejak = t; heningSejak = 0; }
        else if (bicaraSejak && !heningSejak) heningSejak = t;
        const selesai = bicaraSejak && ((heningSejak && t - heningSejak > JEDA_SELESAI_MS) || t - bicaraSejak > UCAPAN_MAKS_MS);
        if (selesai || (!bicaraSejak && t - mulai > TUNGGU_MAKS_MS)) { clearInterval(pantau); pantau = undefined; r.stop(); }
      }, 100);
    }

    async function start() {
      phase = 'connecting'; mode = 'diam'; service = null; secs = 0; msgs = [];
      idPanggilan = crypto.randomUUID();
      giliranTiruan = null;
      const demo = import.meta.env.DEV && new URLSearchParams(location.search).get('demo');
      if (demo) {
        const { TRANSKRIP_TIRUAN } = await import('../lib/mock/transkripTiruan');
        giliranTiruan = (TRANSKRIP_TIRUAN[demo] ?? []).map((g) => ({ transkrip: g.ucapan, jawaban: g.jawaban, suara: null, produk: g.produk, tiket: g.tiket }));
      }
      paint();
      clearInterval(tick);
      tick = window.setInterval(() => { if (phase !== 'ended') { secs++; $('[data-dur]').textContent = stamp(); } }, 1000);
      try {
        mic = await navigator.mediaDevices.getUserMedia({ audio: { echoCancellation: true, noiseSuppression: true, autoGainControl: true } });
        ctx = new AudioContext();
        analis = ctx.createAnalyser();
        analis.fftSize = 1024;
        ctx.createMediaStreamSource(mic).connect(analis);
      } catch {
        mic = null;
      }
      if (phase === 'ended') return lepasMic();
      phase = 'menu';
      say(PESAN_MENU);
      push({ kind: 'menu' });
      if (!mic) say('Izin mikrofon ditolak. Izinkan mikrofon di browser agar bisa berbicara dengan CS AI.');
      await putar(`${GATEWAY}/statis/menu`);
      if (phase !== 'ended') dengar();
    }

    async function pick(n: 1 | 2) {
      if (phase === 'ended' || phase === 'connecting') return;
      berhentiRekam();
      pemutar.pause();
      phase = 'flow'; service = n;
      msgs = msgs.filter((m) => m.kind !== 'menu');
      setMode('memproses');
      try { await prosesHasil(await kirimGiliran({ pilih: n })); } catch (e) { gagal(e); }
    }

    function lepasMic() {
      berhentiRekam();
      mic?.getTracks().forEach((t) => t.stop());
      mic = null;
      ctx?.close().catch(() => {});
      ctx = null;
      analis = null;
    }

    function end() {
      if (phase === 'ended') return;
      lepasMic();
      pemutar.pause();
      if (idPanggilan) fetch(`${GATEWAY}/akhiri`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id: idPanggilan }) }).catch(() => {});
      // REQ-2.5: pengaduan lewat suara belum menerbitkan nomor tiket.
      const text = service === 2
        ? 'Panggilan berakhir. Pengaduan belum lengkap sehingga nomor tiket tidak diterbitkan.'
        : 'Panggilan berakhir. Transkrip tersimpan di register layanan.';
      phase = 'ended';
      msgs = msgs.filter((m) => m.kind !== 'processing' && m.kind !== 'menu');
      push({ kind: 'ended', text });
    }

    function close() {
      end();
      clearInterval(tick);
      root.hidden = true;
      document.documentElement.classList.remove('panel-open');
    }

    root.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const p = t.closest<HTMLElement>('[data-pick]');
      if (p) return pick(Number(p.dataset.pick) as 1 | 2);
      if (t.closest('[data-close]')) return close();
      if (t.closest('[data-end]')) return end();
      if (t.closest('[data-restart]')) return start();
      if (t.closest('[data-ganti]') && phase === 'flow') { phase = 'menu'; service = null; say(PESAN_MENU); push({ kind: 'menu' }); }
    });
    root.addEventListener('keydown', (e) => { if (e.key === '1' || e.key === '2') pick(Number(e.key) as 1 | 2); if (e.key === 'Escape') close(); });

    return () => {
      root.hidden = false;
      document.documentElement.classList.add('panel-open');
      start();
      $('[data-end]').focus();
    };
  }

  const openers = new Map<string, () => void>();
  document.querySelectorAll<HTMLElement>('[data-panel]').forEach((el) => openers.set(el.dataset.panel!, setup(el)));

  // REQ-1.1: tombol "Telepon CS AI" membuka panel dan memutar menu layanan.
  window.addEventListener('sigap:buka-panggilan', () => {
    const mobile = matchMedia('(max-width: 767px)').matches && openers.has('mobile');
    openers.get(mobile ? 'mobile' : 'desktop')?.();
  });
</script>

<style>
  .panel-wrap[hidden] { display: none; }
  .desktop .dim { position: absolute; inset: 0; background: rgba(40, 46, 60, .28); backdrop-filter: blur(3px); z-index: 20; }
  .desktop .panel-suara { position: absolute; right: 20px; bottom: 20px; width: 460px; height: 820px; border-radius: 38px; border: 1px solid rgba(255, 255, 255, .9); box-shadow: 0 40px 80px rgba(20, 30, 60, .35); z-index: 21; padding: 22px; }
  .mobile .ps-status { gap: 8px; padding: 12px 14px; }
  .mobile .panel-suara { position: fixed; inset: 0; z-index: 50; padding: max(20px, env(safe-area-inset-top)) 20px max(24px, env(safe-area-inset-bottom)); }

  .panel-suara { display: flex; flex-direction: column; gap: 14px; overflow: hidden; background: #f4f5f7; color: var(--ink); }
  .grow { flex: 1; }
  .ps-head { display: flex; align-items: center; gap: 14px; }
  .ps-orb { width: 52px; height: 52px; border-radius: 999px; flex: none; background: radial-gradient(circle at 34% 28%, #ffffff 0%, #d5e4ff 16%, #86b2ff 44%, #3f7cf7 74%, #2a5ee0 100%); box-shadow: 0 10px 22px rgba(47, 107, 245, .35), inset -4px -6px 12px rgba(20, 60, 180, .3); }
  .ps-id { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .ps-name { font-size: 19px; font-weight: 600; letter-spacing: -.01em; }
  .ps-sub { font-size: 14px; color: #6b7280; }
  .ps-min { width: 46px; height: 46px; border-radius: 999px; border: 1px solid #fff; background: var(--surface-2); box-shadow: 0 2px 8px rgba(16, 24, 40, .08); display: flex; align-items: center; justify-content: center; color: var(--ink-3); font-size: 20px; }

  .ps-status { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-radius: 18px; background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-row); }
  .ps-dot { width: 9px; height: 9px; border-radius: 99px; background: #22c55e; }
  .live .ps-dot { animation: sgPulse 1.4s ease-out infinite; }
  .ended .ps-dot { background: #9aa1ad; }
  .ps-state { font-size: 14px; font-weight: 600; letter-spacing: .08em; color: #15803d; }
  .ended .ps-state { color: #6b7280; }
  .ps-wave { display: flex; align-items: center; gap: 3px; height: 20px; }
  .ps-wave span { width: 3px; border-radius: 3px; background: #cfd4dc; transform-origin: center; }
  .live .ps-wave span { background: #93b4f8; animation-name: sgWave; animation-timing-function: ease-in-out; animation-iteration-count: infinite; }
  .ps-dur-label { font-size: 12px; letter-spacing: .1em; color: #6b7280; }
  .ps-dur { font-size: 16px; font-weight: 600; }

  .ps-service { display: flex; align-items: center; gap: 14px; padding: 12px 14px; border-radius: 18px; background: linear-gradient(180deg, #eef3ff, #e3ebfd); border: 1px solid #d9e3f8; }
  .ps-service[hidden] { display: none; }
  .ps-service-no { width: 42px; height: 42px; border-radius: 12px; background: var(--grad-blue); color: #fff; font-size: 20px; font-weight: 600; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 10px rgba(47, 107, 245, .3); }
  .ps-service-text { flex: 1; display: flex; flex-direction: column; gap: 1px; }
  .ps-service-text span:first-child { font-size: 12px; font-weight: 600; letter-spacing: .08em; color: #2152c9; }
  .ps-service-text span:last-child { font-size: 17px; font-weight: 600; color: #1a3a8f; }
  .ps-ganti { border: 0; background: transparent; color: #2152c9; font-weight: 600; font-size: 15px; }

  .ps-tr-head { display: flex; align-items: center; justify-content: space-between; padding: 0 4px; }
  .ps-tr-head > span:first-child { font-size: 13px; font-weight: 600; letter-spacing: .1em; color: #4b5260; }
  .ps-saved { display: flex; align-items: center; gap: 6px; font-size: 13px; color: #15803d; }
  .ps-tr { flex: 1; min-height: 0; overflow-y: auto; display: flex; flex-direction: column; gap: 12px; padding: 16px; border-radius: 24px; background: #eceef2; box-shadow: inset 0 1px 3px rgba(16, 24, 40, .06); }

  .ps-tr :global(.m-sys), .ps-tr :global(.m-user) { display: flex; flex-direction: column; gap: 5px; max-width: 86%; }
  .ps-tr :global(.m-sys) { align-items: flex-start; }
  .ps-tr :global(.m-user) { align-items: flex-end; align-self: flex-end; }
  .ps-tr :global(.m-sys > span), .ps-tr :global(.m-user > span) { font-size: 11.5px; font-weight: 600; letter-spacing: .1em; color: var(--muted-2); }
  .ps-tr :global(.m-user > span) { color: #2152c9; }
  .ps-tr :global(.m-sumber) { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .ps-tr :global(.m-sumber a), .ps-tr :global(.m-sumber span) { display: inline-block; padding: 4px 10px; border-radius: 999px; background: #eef3ff; border: 1px solid #d3dff9; color: #1d3f9e; font-size: 12.5px; font-weight: 600; text-decoration: none; }
  .ps-tr :global(.m-sumber a:hover), .ps-tr :global(.m-sumber a:focus-visible) { background: #dce7fe; text-decoration: underline; }
  /* T-F1.2-01: kartu hasil cek produk. Status selalu tampil sebagai ikon dan teks, tidak hanya warna. */
  .ps-tr :global(.m-sys:has(.k-produk, .k-eskalasi)) { max-width: 100%; }
  .ps-tr :global(.k-produk) { width: 100%; box-sizing: border-box; display: flex; flex-direction: column; gap: 8px; padding: 12px 14px; border-radius: 14px; background: #fff; border: 1px solid #dfe3ea; font-size: 14px; }
  .ps-tr :global(.k-produk-nama) { font-size: 15.5px; font-weight: 600; }
  .ps-tr :global(.k-produk dl) { display: grid; grid-template-columns: auto 1fr; gap: 3px 12px; margin: 0; }
  .ps-tr :global(.k-produk dt) { color: #6b7280; }
  .ps-tr :global(.k-produk dd) { margin: 0; font-weight: 500; overflow-wrap: anywhere; }
