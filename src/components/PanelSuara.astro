---
// Boundary UC-01/UC-02: panel percakapan suara "CS AI HaloBPOM" (REQ-1.1, REQ-1.2, REQ-2.1, REQ-2.2, REQ-2.4, REQ-2.5, T-F4.1-03).
// Dibuka lewat event `sigap:buka-panggilan`. Suara penelepon direkam di browser lalu dikirim ke
// Voice Gateway (/voice) yang meneruskannya ke ElevenLabs STT, Hermes Agent, dan ElevenLabs TTS.
// Penelepon juga bisa mengetik: pesan dikirim sebagai JSON {id, teks} ke endpoint yang sama, tanpa STT.
interface Props { mode: 'desktop' | 'mobile' }
const { mode } = Astro.props;
const bars = [0.5, 0.9, 0.6, 1, 0.7, 0.4, 0.85, 0.55, 0.95, 0.5, 0.7, 0.45];
---
<div class:list={['panel-wrap', mode]} data-panel={mode} hidden>
  {mode === 'desktop' && <div class="dim" data-close></div>}
  <section class="panel-suara" data-name="PanelPercakapanSuara" role="dialog" aria-modal="true" aria-label="Panel percakapan suara CS AI HaloBPOM">
    <div class="ps-head">
      <div class="ps-orb" aria-hidden="true"></div>
      <div class="ps-id"><div class="ps-name">CS AI HaloBPOM</div><div class="ps-sub">Asisten suara resmi · SIGAP</div></div>
      <button class="ps-min" data-close title="Perkecil" aria-label="Perkecil panel"><i class="icon-minus"></i></button>
    </div>
    <div class="ps-status">
      <span class="ps-dot" data-dot></span>
      <span class="ps-state" data-state>MENYAMBUNGKAN</span>
      <span class="ps-wave" aria-hidden="true">{bars.map((h, i) => <span style={`height:${20 * h}px;animation-duration:${0.7 + (i % 4) * 0.15}s;animation-delay:${i * 0.06}s`}></span>)}</span>
      <span class="grow"></span>
      <span class="ps-dur-label">DURASI</span>
      <span class="ps-dur mono" data-dur>00:00</span>
    </div>
    <div class="ps-service" data-service hidden>
      <div class="ps-service-no" data-service-no>1</div>
      <div class="ps-service-text"><span>LAYANAN DIPILIH</span><span data-service-name>Informasi Produk</span></div>
      <button class="ps-ganti" data-ganti>Ganti</button>
    </div>
    <div class="ps-tr-head">
      <span>TRANSKRIP LANGSUNG</span>
      <span class="ps-saved"><i class="icon-check"></i>{mode === 'mobile' ? 'tersimpan' : 'tersimpan di register layanan'}</span>
    </div>
    <div class="ps-tr" data-tr data-name="TranskripPercakapan" role="log" aria-live="polite" aria-label="Transkrip langsung"></div>
    <form class="ps-ketik" data-ketik autocomplete="off">
      <div class="ps-kontrol">
        <button type="button" class="ps-suara" data-suara role="switch" aria-checked="true" title="Matikan suara jawaban">
          <i class="icon-volume-2" data-suara-ikon aria-hidden="true"></i>
          <span class="ps-suara-label">Suara jawaban</span>
          <span class="ps-suara-sw" aria-hidden="true"></span>
        </button>
        <button type="button" class="ps-suara" data-mic role="switch" aria-checked="true" title="Matikan mikrofon (M)">
          <i class="icon-mic" data-mic-ikon aria-hidden="true"></i>
          <span class="ps-suara-label">Mikrofon</span>
          <span class="ps-suara-sw" aria-hidden="true"></span>
        </button>
      </div>
      <div class="ps-ketik-baris">
        <label class="sr-only" for={`ps-ketik-${mode}`}>Ketik pertanyaan untuk CS AI</label>
        <input id={`ps-ketik-${mode}`} class="ps-input" data-input type="text" maxlength="500" placeholder="Ketik pertanyaan…" enterkeyhint="send" />
        <button type="submit" class="btn-primary ps-kirim" data-kirim aria-label="Kirim pertanyaan" title="Kirim"><i class="icon-send"></i></button>
      </div>
    </form>
    <button class="ps-end" data-end><i class="icon-phone-off"></i>Akhiri Panggilan</button>
    <div class="ps-after" data-after hidden>
      <button class="ps-restart" data-restart><i class="icon-phone"></i>Telepon CS AI</button>
      <button class="ps-close" data-close>Tutup</button>
    </div>
  </section>
</div>

<script>
  import { GalatGateway, PESAN_GANGGUAN_SUARA, esc, htmlKartuProduk, htmlKartuTiket, pesanAkhirPanggilan, pesanGalatPanggilan, type HasilProduk } from '../lib/kartuPanggilan';
  import { NAMA_PERISTIWA, type PeristiwaCari, type TabelCek } from '../lib/cariProduk';

  type Sumber = { peraturan: string; judul: string; url: string };
  // `live`: gelembung penelepon yang masih diperbarui transkrip live (teks sementara STT realtime).
  type Msg = { kind: 'sys' | 'user' | 'menu' | 'processing' | 'ended'; text?: string; time?: string; sumber?: Sumber[]; produk?: HasilProduk; tiket?: string; pengaduan?: string; live?: boolean };
  // Baris NDJSON dari /voice/giliran untuk ucapan: transkrip, lalu kalimat demi kalimat, lalu selesai.
  type Baris =
    | { jenis: 'transkrip'; transkrip: string; jeda?: boolean }
    | { jenis: 'kalimat'; teks: string; suara: string | null }
    | { jenis: 'ganti' }
    | { jenis: 'cari'; kueri: string }
    | ({ jenis: 'cek' } & TabelCek)
    | { jenis: 'selesai'; sumber?: Sumber[]; akhiri?: boolean; tiket?: string | null; produk?: HasilProduk; pengaduan?: string | null; layanan?: 1 | 2 }
    | { jenis: 'galat'; message: string };
  type Hasil = { transkrip: string | null; jawaban: string | null; suara: string | null; akhiri?: boolean; sumber?: Sumber[]; produk?: HasilProduk; tiket?: string; pengaduan?: string | null };

  const GATEWAY = '/voice';
  // Panel Cari Produk di halaman publik mengikuti layanan dan pencarian cekbpom dalam panggilan ini.
  const kabari = (p: PeristiwaCari) => window.dispatchEvent(new CustomEvent(NAMA_PERISTIWA, { detail: p }));
  const PESAN_MENU = 'Tekan 1 untuk informasi produk, tekan 2 untuk pengaduan.'; // REQ-1.1
  // Deteksi giliran bicara sederhana dari kekuatan sinyal mikrofon.
  const AMBANG_SUARA = 0.025;
  const JEDA_SELESAI_MS = 800;
  const UCAPAN_MAKS_MS = 15_000;
  const TUNGGU_MAKS_MS = 8_000;
  // Sesi STT realtime ditutup bila penelepon diam selama ini, karena setiap detik audio yang dikirim ditagih.
  const DIAM_LIVE_MS = 30_000;

  function keBase64(buf: ArrayBuffer) {
    const u = new Uint8Array(buf);
    let s = '';
    for (let i = 0; i < u.length; i += 0x8000) s += String.fromCharCode.apply(null, u.subarray(i, i + 0x8000) as unknown as number[]);
    return btoa(s);
  }

  // REQ-1.6 (T-F1.3-01): chip sumber rujukan di bawah jawaban agen, dibaca pembaca layar sebagai "Sumber: ...".
  function chipSumber(s: Sumber) {
    const label = esc(s.peraturan);
    const judul = esc(s.judul);
    return /^https?:\/\//.test(s.url)
      ? `<li><a href="${esc(s.url)}" target="_blank" rel="noopener" title="${judul}" aria-label="Sumber: ${label}">${label}</a></li>`
      : `<li><span title="${judul}" aria-label="Sumber: ${label}">${label}</span></li>`;
  }

  function render(m: Msg) {
    switch (m.kind) {
      case 'sys': return `<div class="m-sys"><span>CS AI · ${m.time}</span><div>${esc(m.text!)}</div>${
        m.produk ? htmlKartuProduk(m.produk) : ''}${htmlKartuTiket(m)}${
        m.sumber?.length ? `<ul class="m-sumber" aria-label="Sumber rujukan">${m.sumber.map(chipSumber).join('')}</ul>` : ''}</div>`;
      case 'user': return `<div class="m-user${m.live ? ' live' : ''}"><span>ANDA · ${m.time}</span><div>${esc(m.text!)}</div></div>`;
      case 'menu': return `<div class="m-menu" role="group" aria-label="Pilihan menu layanan">
        <button data-pick="1" type="button" aria-label="1: Informasi Produk - Izin edar dan edukasi obat &amp; makanan"><span class="no" aria-hidden="true">1</span><span class="t">Informasi Produk</span><span class="d">Izin edar dan edukasi obat &amp; makanan</span></button>
        <button data-pick="2" type="button" aria-label="2: Pengaduan Produk - Laporkan produk yang bermasalah"><span class="no purple" aria-hidden="true">2</span><span class="t">Pengaduan Produk</span><span class="d">Laporkan produk yang bermasalah</span></button></div>`;
      case 'processing': return `<div class="m-proc"><i class="icon-loader-circle"></i>${esc(m.text!)}</div>`;
      case 'ended': return `<div class="m-ended"><i class="icon-phone-off"></i><span>${esc(m.text!)}</span></div>`;
    }
  }

  function setup(root: HTMLElement) {
    const $ = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const tr = $('[data-tr]');
    let phase: 'connecting' | 'menu' | 'flow' | 'ended' = 'connecting';
    let mode: 'diam' | 'mendengar' | 'memproses' | 'berbicara' = 'diam';
    let service: 1 | 2 | null = null, tiketPengaduan = false, secs = 0, msgs: Msg[] = [];
    let tick: number | undefined, idPanggilan = '';
    let mic: MediaStream | null = null, ctx: AudioContext | null = null, analis: AnalyserNode | null = null, rekam: MediaRecorder | null = null;
    let pantau: number | undefined;
    // Transkrip live: `realtime` mati untuk sisa panggilan bila token atau koneksi STT realtime gagal; `stt` adalah sesi yang berjalan.
    let realtime = true, stt: { tutup: () => void } | null = null, modulPcm: Promise<void> | null = null;
    // Pesan diketik: `sibuk` selama satu giliran berjalan (input dikunci), `mengetik` selama ada draf di kolom
    // (mikrofon berhenti merekam supaya suara latar tidak memotong ketikan), `suaraAktif` untuk audio jawaban.
    let sibuk = false, mengetik = false, suaraAktif = true, fokusKetik = false;
    // Tombol "Mikrofon": penelepon bisa membisukan mikrofon selagi berpikir atau berbicara dengan orang lain,
    // supaya ucapan itu tidak ikut terkirim ke CS AI. Selama bisu tidak ada yang direkam maupun dialirkan ke STT.
    let micAktif = true;
    let akhiriPutar: (() => void) | null = null;
    const input = $<HTMLInputElement>('[data-input]'), kirimBtn = $<HTMLButtonElement>('[data-kirim]'), suaraBtn = $<HTMLButtonElement>('[data-suara]');
    const micBtn = $<HTMLButtonElement>('[data-mic]');
    const pemutar = new Audio();
    // Tempo bicara gaya CS. Model TTS v3 tidak punya pengaturan kecepatan, jadi audio dipercepat di sini
    // dengan nada tetap. defaultPlaybackRate dipakai karena mengganti src mengembalikan playbackRate ke nilai itu.
    const KECEPATAN_PUTAR = 1.2;
    pemutar.defaultPlaybackRate = pemutar.playbackRate = KECEPATAN_PUTAR;
    pemutar.preservesPitch = true;

    const stamp = () => `${String(Math.floor(secs / 60)).padStart(2, '0')}:${String(secs % 60).padStart(2, '0')}`;
    const LABEL = { diam: 'TERSAMBUNG', mendengar: 'MENDENGARKAN', memproses: 'MEMPROSES', berbicara: 'BERBICARA' };

    function paint() {
      const ended = phase === 'ended', live = !ended && phase !== 'connecting';
      tr.innerHTML = msgs.map(render).join('');
      tr.scrollTop = tr.scrollHeight;
      $('[data-state]').textContent = ended ? 'BERAKHIR' : phase === 'connecting' ? 'MENYAMBUNGKAN' : !micAktif && mode === 'diam' ? 'MIKROFON MATI' : LABEL[mode];
      root.classList.toggle('live', live);
      root.classList.toggle('ended', ended);
      $('[data-dur]').textContent = stamp();
      $('[data-service]').hidden = !service || ended;
      if (service) {
        $('[data-service-no]').textContent = String(service);
        $('[data-service-name]').textContent = service === 1 ? 'Informasi Produk' : 'Pengaduan Produk';
      }
      $('[data-end]').hidden = ended;
      $('[data-after]').hidden = !ended;
      $('[data-ketik]').hidden = ended;
      const kunci = phase === 'connecting' || ended || sibuk;
      input.disabled = kunci;
      kirimBtn.disabled = kunci || !input.value.trim();
      if (!kunci && fokusKetik) { fokusKetik = false; input.focus(); }
    }
    const push = (m: Msg) => { msgs = msgs.filter((x) => x.kind !== 'processing').concat({ ...m, time: stamp() }); paint(); };
    const say = (text: string, sumber?: Sumber[], produk?: HasilProduk, tiket?: string, pengaduan?: string) => push({ kind: 'sys', text, sumber, produk, tiket, pengaduan });
    const setMode = (m: typeof mode) => { mode = m; paint(); };

    // Putar audio jawaban lalu kembali mendengarkan. Mikrofon tidak merekam selama agen berbicara.
    function putar(src: string) {
      if (!suaraAktif) return Promise.resolve();
      return new Promise<void>((selesai) => {
        setMode('berbicara');
        akhiriPutar = selesai;
        pemutar.src = src;
        pemutar.onended = pemutar.onerror = () => selesai();
        pemutar.play().catch(() => selesai());
      });
    }

    // Tombol "Suara jawaban": mematikan atau menyalakan audio. Audio yang sedang diputar dihentikan, giliran tetap berjalan sebagai teks.
    function aturSuara(aktif: boolean) {
      suaraAktif = aktif;
      suaraBtn.setAttribute('aria-checked', String(aktif));
      suaraBtn.title = aktif ? 'Matikan suara jawaban' : 'Nyalakan suara jawaban';
      $('[data-suara-ikon]').className = aktif ? 'icon-volume-2' : 'icon-volume-x';
      if (!aktif) { antrean = []; pemutar.pause(); akhiriPutar?.(); }
    }

    // Bisukan atau nyalakan mikrofon. Ucapan yang sedang direkam dibuang (tidak dikirim); track dimatikan agar tidak ada audio
    // yang terbaca. Saat dinyalakan lagi dan agen sedang menunggu, mendengarkan langsung dimulai.
    function aturMic(aktif: boolean) {
      micAktif = aktif;
      micBtn.setAttribute('aria-checked', String(aktif));
      micBtn.title = aktif ? 'Matikan mikrofon (M)' : 'Nyalakan mikrofon (M)';
      $('[data-mic-ikon]').className = aktif ? 'icon-mic' : 'icon-mic-off';
      mic?.getAudioTracks().forEach((t) => { t.enabled = aktif; });
      if (!aktif) {
        berhentiRekam();
        if (mode === 'mendengar') setMode('diam');
        else paint();
      } else if (!sibuk && (phase === 'menu' || phase === 'flow') && mode === 'diam') dengar();
      else paint();
    }

    // Antrean audio: kalimat jeda lalu kalimat jawaban diputar berurutan begitu masing-masing siap.
    let antrean: string[] = [];
    let pemutaran: Promise<void> | null = null;
    // Giliran ucapan yang sedang berjalan, dibatalkan saat panggilan diakhiri agar gateway berhenti memanggil AI dan TTS.
    let batalGiliran: AbortController | null = null;
    function antrekan(src: string) {
      if (!suaraAktif) return;
      antrean.push(src);
      pemutaran ??= (async () => {
        while (antrean.length && phase !== 'ended') await putar(antrean.shift()!);
        pemutaran = null;
      })();
    }
    async function tungguAntrean() {
      while (pemutaran) await pemutaran;
    }
    // Naik setiap kali suara dihentikan (pilih layanan, akhiri panggilan). Alur lama yang sedang menunggu audio
    // membandingkannya setelah audio selesai, agar tidak mendengar atau memutar lagi di atas alur yang baru.
    let sesiSuara = 0;
    function hentikanSuara() {
      sesiSuara++;
      batalGiliran?.abort();
      batalGiliran = null;
      antrean = [];
      pemutar.pause();
      // pause() tidak memicu `ended`: selesaikan putar() yang sedang menunggu agar antrean tidak macet.
      pemutar.dispatchEvent(new Event('ended'));
    }

    // Mode demo dev server (?demo=<nama>): giliran diambil dari transkrip tiruan, bukan dari gateway suara.
    let giliranTiruan: Hasil[] | null = null;

    async function kirimGiliran(body: Blob | { pilih: number }) {
      if (giliranTiruan) return giliranTiruan.shift() ?? { transkrip: null, jawaban: null, suara: null };
      const audio = body instanceof Blob;
      const r = await fetch(audio ? `${GATEWAY}/giliran?id=${idPanggilan}` : `${GATEWAY}/giliran`, {
        method: 'POST',
        headers: { 'content-type': audio ? (body.type || 'audio/webm') : 'application/json' },
        body: audio ? body : JSON.stringify({ id: idPanggilan, ...body }),
      });
      const d = await r.json().catch(() => null);
      if (!r.ok || !d?.data) throw new GalatGateway(d?.message ?? PESAN_GANGGUAN_SUARA);
      return d.data as Hasil;
    }

    async function prosesHasil(h: Hasil) {
      if (phase === 'ended') return;
      const sesi = sesiSuara;
      if (h.transkrip) push({ kind: 'user', text: h.transkrip });
      if (h.pengaduan) tiketPengaduan = true;
      else if (h.tiket?.startsWith('ADU-')) tiketPengaduan = true;
      if (h.jawaban) say(h.jawaban, h.sumber, h.produk, h.tiket, h.pengaduan ?? undefined);
      if (h.suara) await putar(h.suara);
      if (sesi !== sesiSuara) return;
      // Penelepon tidak butuh bantuan lagi: tutup panggilan setelah salam penutup selesai diputar.
      if (h.akhiri) return end();
      // Mode demo tanpa mikrofon: giliran tiruan berikutnya langsung diputar.
      if (giliranTiruan?.length) return prosesHasil(giliranTiruan.shift()!);
      if (phase !== 'ended') dengar();
    }

    // Jawaban ucapan datang bertahap: kalimat jeda diputar segera, tiap kalimat jawaban diantrekan begitu tiba.
    async function prosesAliran(r: Response, ketikan = false) {
      const sesi = sesiSuara;
      const pembaca = r.body!.getReader();
      const dekoder = new TextDecoder();
      let sisa = '', jawaban: Msg | null = null, akhiri = false, ganti = false;
      for (;;) {
        const { value, done } = await pembaca.read();
        if (done) break;
        if (phase === 'ended') { pembaca.cancel().catch(() => {}); break; }
        sisa += dekoder.decode(value, { stream: true });
        let n;
        while ((n = sisa.indexOf('\n')) >= 0) {
          const b = JSON.parse(sisa.slice(0, n)) as Baris;
          sisa = sisa.slice(n + 1);
          if (b.jenis === 'transkrip') {
            // Pesan yang diketik sudah tampil sebagai gelembung pengguna begitu dikirim.
            if (b.transkrip && !ketikan) push({ kind: 'user', text: b.transkrip });
            if (b.jeda) { antrekan(`${GATEWAY}/statis/jeda`); push({ kind: 'processing', text: 'Menyiapkan jawaban' }); }
          } else if (b.jenis === 'kalimat') {
            if (jawaban) { jawaban.text = ganti ? b.teks : `${jawaban.text} ${b.teks}`; ganti = false; paint(); }
            else { say(b.teks); jawaban = msgs[msgs.length - 1]; }
            if (b.suara) antrekan(b.suara);
          } else if (b.jenis === 'cari') {
            kabari({ tahap: 'cari', kueri: b.kueri });
          } else if (b.jenis === 'cek') {
            const { jenis: _, ...tabel } = b;
            kabari({ tahap: 'hasil', tabel });
          } else if (b.jenis === 'ganti') {
            // Gateway menarik jawaban yang sudah dikirim (jawaban baku dikenali belakangan).
            antrean = [];
            ganti = true;
          } else if (b.jenis === 'selesai') {
            // UC-01 Alternative Path 3: gateway memilih layanan dari ucapan "dua" setelah tawaran tekan 2, sama seperti pick().
            if (b.layanan) {
              phase = 'flow'; service = b.layanan; tiketPengaduan = false;
              msgs = msgs.filter((m) => m.kind !== 'menu');
              kabari({ tahap: 'layanan', layanan: b.layanan });
              paint();
            }
            // REQ-2.3: tiket pengaduan datang pada baris selesai; panggilan yang sudah bertiket tidak lagi dianggap pengaduan belum lengkap.
            if (b.pengaduan || b.tiket?.startsWith('ADU-')) tiketPengaduan = true;
            if (jawaban) { jawaban.sumber = b.sumber; jawaban.tiket = b.tiket ?? undefined; jawaban.pengaduan = b.pengaduan ?? undefined; jawaban.produk = b.produk; paint(); }
            akhiri = Boolean(b.akhiri);
          } else if (b.jenis === 'galat') {
            throw new GalatGateway(b.message);
          }
        }
      }
      await tungguAntrean();
      if (phase === 'ended' || sesi !== sesiSuara) return;
      // Penelepon tidak butuh bantuan lagi: tutup panggilan setelah salam penutup selesai diputar.
      if (akhiri) return end();
      dengar();
    }

    async function giliranSuara(rekaman: Blob) {
      const sesi = sesiSuara;
      sibuk = true;
      setMode('memproses');
      push({ kind: 'processing', text: 'Memproses ucapan Anda' });
      try {
        if (giliranTiruan) return await prosesHasil(await kirimGiliran(rekaman));
        batalGiliran = new AbortController();
        const r = await fetch(`${GATEWAY}/giliran?id=${idPanggilan}`, {
          method: 'POST', headers: { 'content-type': rekaman.type || 'audio/webm' }, body: rekaman, signal: batalGiliran.signal,
        });
        await prosesAliran(await pastikanAliran(r));
      } catch (e) {
        await tungguAntrean();
        // Giliran dihentikan oleh pick() atau end(), termasuk AbortError dari fetch: alur baru yang melanjutkan.
        if (sesi !== sesiSuara) return;
        gagal(e);
      }
    }

    async function pastikanAliran(r: Response) {
      if (!r.ok || !r.headers.get('content-type')?.includes('ndjson')) {
        const d = await r.json().catch(() => null);
        throw new GalatGateway(d?.message ?? PESAN_GANGGUAN_SUARA);
      }
      return r;
    }

    // Pesan diketik: gelembung pengguna tampil langsung, lalu dikirim ke endpoint yang sama dan dibaca lewat prosesAliran
    // yang sama, jadi kartu produk, panel Cari Produk, menu, dan eskalasi bekerja persis seperti pada suara.
    // `ucapan`: teks final dari transkrip live, gelembungnya sudah tampil dan tidak dikembalikan ke kolom ketik bila gagal.
    async function giliranKetik(teks: string, ucapan = false) {
      if (phase === 'ended' || phase === 'connecting' || sibuk) return;
      sibuk = true;
      berhentiRekam();
      antrean = [];
      pemutar.pause();
      if (!ucapan) push({ kind: 'user', text: teks });
      setMode('memproses');
      push({ kind: 'processing', text: ucapan ? 'Memproses ucapan Anda' : 'Memproses pertanyaan Anda' });
      try {
        if (giliranTiruan) {
          const h = giliranTiruan.shift() ?? { transkrip: null, jawaban: null, suara: null };
          return await prosesHasil({ ...h, transkrip: null });
        }
        const r = await fetch(`${GATEWAY}/giliran`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id: idPanggilan, teks }) });
        await prosesAliran(await pastikanAliran(r), true);
      } catch (e) {
        await tungguAntrean();
        // Kembalikan pesan ke kolom agar bisa dikirim ulang tanpa mengetik lagi.
        if (!ucapan && !input.value) { input.value = teks; mengetik = true; }
        gagal(e);
      }
    }

    function gagal(e: unknown) {
      if (phase === 'ended') return;
      say(pesanGalatPanggilan(e));
      dengar();
    }

    function berhentiRekam() {
      stt?.tutup();
      stt = null;
      clearInterval(pantau);
      pantau = undefined;
      if (rekam && rekam.state !== 'inactive') { rekam.ondataavailable = null; rekam.onstop = null; rekam.stop(); }
      rekam = null;
    }

    function dengar() {
      berhentiRekam();
      sibuk = false;
      if (phase === 'ended' || phase === 'connecting' || !mic || !ctx || !analis || mengetik || !micAktif) { setMode('diam'); return; }
      setMode('mendengar');
      ctx.resume().catch(() => {});
      if (realtime && !giliranTiruan && ctx.audioWorklet) dengarLive();
      else dengarLokal();
    }

    // Transkrip live (REQ-1.2): selama mendengarkan, audio dialirkan langsung ke STT realtime ElevenLabs dan teks sementaranya
    // tampil di gelembung penelepon. Begitu ucapan ditetapkan (jeda 0,8 detik), teksnya dikirim sebagai giliran teks. Bila token
    // atau koneksi gagal, sisa panggilan kembali ke rekam lalu unggah.
    async function dengarLive() {
      let ws: WebSocket | null = null, node: AudioWorkletNode | null = null, sumber: MediaStreamAudioSourceNode | null = null;
      let gelembung: Msg | null = null, siap = false, batasDiam: number | undefined, batasUcapan: number | undefined;
      const tertunda: string[] = [];
      const s = {
        tutup() {
          clearTimeout(batasDiam);
          clearTimeout(batasUcapan);
          sumber?.disconnect();
          node?.port.close();
          node?.disconnect();
          if (ws && ws.readyState <= WebSocket.OPEN) ws.close();
          // Ucapan yang terpotong (mengetik, pilih layanan, akhiri) tidak dikirim, jadi teks sementaranya dibuang.
          if (gelembung?.live) { msgs = msgs.filter((m) => m !== gelembung); paint(); }
        },
      };
      stt = s;
      const aktif = () => stt === s;
      const selesai = () => { s.tutup(); stt = null; };
      // Giliran ini kembali ke rekam lalu unggah. `permanen` (token ditolak, koneksi tidak pernah tersambung, auth atau kuota)
      // mematikan transkrip live untuk sisa panggilan; gangguan sesaat hanya berlaku untuk giliran ini.
      const gagalLive = (permanen: boolean) => { if (!aktif()) return; if (permanen) realtime = false; selesai(); dengarLokal(); };
      try {
        const r = await fetch(`${GATEWAY}/stt-realtime`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id: idPanggilan }) });
        const d = await r.json().catch(() => null);
        if (!aktif()) return;
        if (!r.ok || typeof d?.data?.url !== 'string') return gagalLive(true);
        modulPcm ??= ctx!.audioWorklet.addModule('/worklet/pcm16.js');
        await modulPcm;
        if (!aktif()) return;
        ws = new WebSocket(d.data.url);
        node = new AudioWorkletNode(ctx!, 'pcm16', { numberOfOutputs: 0 });
        sumber = ctx!.createMediaStreamSource(mic!);
        sumber.connect(node);
      } catch {
        return gagalLive(true);
      }
      const kirim = (audio: string, commit = false) => ws!.send(JSON.stringify({ message_type: 'input_audio_chunk', audio_base_64: audio, commit, sample_rate: 16000 }));
      // Audio sebelum sesi siap ditahan sebentar (sekitar 3 detik) agar awal ucapan tidak hilang.
      node.port.onmessage = (e) => { const b = keBase64(e.data); if (siap) kirim(b); else if (tertunda.length < 12) tertunda.push(b); };
      ws.onerror = () => gagalLive(!siap);
      ws.onclose = () => gagalLive(!siap);
      ws.onmessage = (e) => {
        if (!aktif()) return;
        const m = JSON.parse(e.data) as { message_type: string; text?: string };
        const teks = m.text?.trim() ?? '';
        if (m.message_type === 'session_started') {
          siap = true;
          tertunda.splice(0).forEach((b) => kirim(b));
        } else if (m.message_type === 'partial_transcript' && teks) {
          if (!gelembung) {
            clearTimeout(batasDiam);
            // Ucapan yang terlalu panjang ditetapkan paksa, sama dengan batas rekaman.
            batasUcapan = window.setTimeout(() => kirim('', true), UCAPAN_MAKS_MS);
            push({ kind: 'user', text: teks, live: true });
            gelembung = msgs[msgs.length - 1];
          } else { gelembung.text = teks; paint(); }
        } else if (m.message_type === 'committed_transcript' && teks) {
          if (gelembung) { gelembung.text = teks; gelembung.live = false; } else push({ kind: 'user', text: teks });
          gelembung = null;
          selesai();
          giliranKetik(teks.slice(0, 500), true);
        } else if (/error|exceeded|limited|overflow|exhausted|throttled|insufficient|invalid|unaccepted/.test(m.message_type)) {
          gagalLive(/auth|quota|unaccepted/.test(m.message_type));
        }
      };
      // Penelepon diam lama: sesi realtime ditutup dan panel menunggu dengan deteksi suara lokal tanpa biaya.
      batasDiam = window.setTimeout(() => { if (aktif()) { selesai(); dengarLokal(); } }, DIAM_LIVE_MS);
    }

    // Rekam satu ucapan: mulai saat sinyal melewati ambang, berhenti setelah jeda hening.
    function dengarLokal() {
      if (!mic || !ctx || !analis) return;
      const a = analis;
      const sampel = new Float32Array(a.fftSize);
      const tipe = ['audio/webm;codecs=opus', 'audio/mp4', 'audio/ogg;codecs=opus'].find((t) => MediaRecorder.isTypeSupported(t));
      const r = new MediaRecorder(mic, tipe ? { mimeType: tipe } : undefined);
      const potongan: Blob[] = [];
      const mulai = Date.now();
      let bicaraSejak = 0, heningSejak = 0;
      r.ondataavailable = (e) => { if (e.data.size) potongan.push(e.data); };
      r.onstop = () => {
        if (rekam === r) rekam = null;
        if (bicaraSejak) giliranSuara(new Blob(potongan, { type: r.mimeType }));
        else dengar();
      };
      r.start(250);
      rekam = r;
      pantau = window.setInterval(() => {
        a.getFloatTimeDomainData(sampel);
        const rms = Math.sqrt(sampel.reduce((n, x) => n + x * x, 0) / sampel.length);
        const t = Date.now();
        if (rms > AMBANG_SUARA) { if (!bicaraSejak) bicaraSejak = t; heningSejak = 0; }
        else if (bicaraSejak && !heningSejak) heningSejak = t;
        const selesai = bicaraSejak && ((heningSejak && t - heningSejak > JEDA_SELESAI_MS) || t - bicaraSejak > UCAPAN_MAKS_MS);
        if (selesai || (!bicaraSejak && t - mulai > TUNGGU_MAKS_MS)) { clearInterval(pantau); pantau = undefined; r.stop(); }
      }, 100);
    }

    async function start() {
      phase = 'connecting'; mode = 'diam'; service = null; tiketPengaduan = false; secs = 0; msgs = [];
      sibuk = false; mengetik = false; fokusKetik = false; input.value = ''; realtime = true;
      kabari({ tahap: 'layanan', layanan: null });
      idPanggilan = crypto.randomUUID();
      giliranTiruan = null;
      const demo = import.meta.env.DEV && new URLSearchParams(location.search).get('demo');
      if (demo) {
        const { TRANSKRIP_TIRUAN } = await import('../lib/mock/transkripTiruan');
        giliranTiruan = (TRANSKRIP_TIRUAN[demo] ?? []).map((g) => ({
          transkrip: g.ucapan,
          jawaban: g.jawaban,
          suara: null,
          produk: g.produk,
          tiket: g.tiket,
          pengaduan: g.pengaduan,
        }));
      }
      paint();
      clearInterval(tick);
      tick = window.setInterval(() => { if (phase !== 'ended') { secs++; $('[data-dur]').textContent = stamp(); } }, 1000);
      // Izin mikrofon diminta di latar: menunya langsung tampil dan mengetik tetap bisa selagi dialog izin terbuka.
      const mikrofon = siapkanMic();
      phase = 'menu';
      say(PESAN_MENU);
      push({ kind: 'menu' });
      const salam = putar(`${GATEWAY}/statis/menu`);
      const ada = await mikrofon;
      if (phase === 'ended') return lepasMic();
      if (!ada) say('Mikrofon tidak tersedia atau izin ditolak. Anda tetap bisa mengetik pertanyaan di kolom bawah, atau izinkan mikrofon di browser untuk berbicara.');
      await salam;
      if (phase !== 'ended' && !sibuk) dengar();
    }

    async function siapkanMic() {
      try {
        mic = await navigator.mediaDevices.getUserMedia({ audio: { echoCancellation: true, noiseSuppression: true, autoGainControl: true } });
        // Mikrofon dibisukan sebelum izin selesai diberikan: track baru langsung ikut bisu.
        mic.getAudioTracks().forEach((t) => { t.enabled = micAktif; });
        ctx = new AudioContext();
        analis = ctx.createAnalyser();
        analis.fftSize = 1024;
        ctx.createMediaStreamSource(mic).connect(analis);
        return true;
      } catch {
        mic = null;
        return false;
      }
    }

    async function pick(n: 1 | 2) {
      if (phase === 'ended' || phase === 'connecting') return;
      if (sibuk) return;
      sibuk = true;
      berhentiRekam();
      // Menu, kalimat jeda, atau jawaban yang sedang diputar dihentikan, dan giliran ucapan yang masih berjalan dibatalkan.
      hentikanSuara();
      phase = 'flow'; service = n; tiketPengaduan = false;
      kabari({ tahap: 'layanan', layanan: n });
      msgs = msgs.filter((m) => m.kind !== 'menu');
      setMode('memproses');
      try { await prosesHasil(await kirimGiliran({ pilih: n })); } catch (e) { gagal(e); }
    }

    function lepasMic() {
      berhentiRekam();
      mic?.getTracks().forEach((t) => t.stop());
      mic = null;
      ctx?.close().catch(() => {});
      ctx = null;
      analis = null;
    }

    function end() {
      if (phase === 'ended') return;
      sibuk = false;
      lepasMic();
      hentikanSuara();
      // REQ-2.5: pengaduan yang belum bertiket saat panggilan berakhir tidak diberi nomor tiket.
      const keadaan = { layanan: service, tiketPengaduan };
      // REQ-2.5: gateway menyimpan pengaduan yang belum lengkap dan membalas dengan pesan akhir panggilan untuk ditampilkan.
      if (idPanggilan) {
        fetch(`${GATEWAY}/akhiri`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id: idPanggilan }) })
          .then((r) => r.json())
          .then((d) => { if (typeof d?.data?.pesan === 'string') msgs = msgs.map((m) => (m.kind === 'ended' ? { ...m, text: pesanAkhirPanggilan({ ...keadaan, akhir: d.data }) } : m)), paint(); })
          .catch(() => {});
      }
      const text = pesanAkhirPanggilan(keadaan);
      phase = 'ended';
      msgs = msgs.filter((m) => m.kind !== 'processing' && m.kind !== 'menu');
      push({ kind: 'ended', text });
    }

    function close() {
      end();
      kabari({ tahap: 'tutup' });
      clearInterval(tick);
      root.hidden = true;
      document.documentElement.classList.remove('panel-open');
    }

    root.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const p = t.closest<HTMLElement>('[data-pick]');
      if (p) {
        // Tombol 2 di kartu tidak ditemukan yang lama tidak memulai ulang pengaduan yang sedang berjalan.
        if (p.closest('.k-produk') && service === 2) return;
        return pick(Number(p.dataset.pick) as 1 | 2);
      }
      if (t.closest('[data-close]')) return close();
      if (t.closest('[data-end]')) return end();
      if (t.closest('[data-restart]')) return start();
      if (t.closest('[data-ganti]') && phase === 'flow') { phase = 'menu'; service = null; kabari({ tahap: 'layanan', layanan: null }); say(PESAN_MENU); push({ kind: 'menu' }); }
    });
    // Tab ditutup atau halaman ditinggalkan saat panggilan berjalan: beri tahu gateway agar pengaduan yang belum lengkap tersimpan.
    window.addEventListener('pagehide', () => {
      if (phase === 'ended' || phase === 'connecting' || !idPanggilan) return;
      navigator.sendBeacon(`${GATEWAY}/akhiri`, new Blob([JSON.stringify({ id: idPanggilan })], { type: 'application/json' }));
    });
    // Tombol 1 dan 2 memilih layanan, kecuali saat pengguna sedang mengetik di kolom pesan.
    root.addEventListener('keydown', (e) => {
      if ((e.key === '1' || e.key === '2') && !(e.target instanceof HTMLInputElement)) pick(Number(e.key) as 1 | 2);
      if (e.key === 'Escape') close();
      if ((e.key === 'm' || e.key === 'M') && !(e.target instanceof HTMLInputElement) && !e.metaKey && !e.ctrlKey && !e.altKey) aturMic(!micAktif);
    });
    $('[data-ketik]').addEventListener('submit', (e) => {
      e.preventDefault();
      const teks = input.value.replace(/\s+/g, ' ').trim();
      if (!teks || sibuk) return;
      input.value = '';
      mengetik = false;
      fokusKetik = true;
      giliranKetik(teks);
    });
    input.addEventListener('input', () => {
      mengetik = input.value.trim().length > 0;
      if (mengetik && !sibuk) { berhentiRekam(); if (phase === 'menu' || phase === 'flow') setMode('diam'); }
      else if (!mengetik && !sibuk && (phase === 'menu' || phase === 'flow') && mode === 'diam') dengar();
      kirimBtn.disabled = input.disabled || !mengetik;
    });
    suaraBtn.addEventListener('click', () => aturSuara(!suaraAktif));
    micBtn.addEventListener('click', () => aturMic(!micAktif));

    return () => {
      root.hidden = false;
      document.documentElement.classList.add('panel-open');
      aturSuara(true);
      aturMic(true);
      start();
      $('[data-end]').focus();
    };
  }

  const openers = new Map<string, () => void>();
  document.querySelectorAll<HTMLElement>('[data-panel]').forEach((el) => openers.set(el.dataset.panel!, setup(el)));

  // REQ-1.1: tombol "Telepon CS AI" membuka panel dan memutar menu layanan.
  window.addEventListener('sigap:buka-panggilan', () => {
    const mobile = matchMedia('(max-width: 767px)').matches && openers.has('mobile');
    openers.get(mobile ? 'mobile' : 'desktop')?.();
  });
</script>

