        // Jarum jam digambar tiap frame mengikuti waktu sebenarnya.
        r(99, 9, 9, 9, P.frame); r(100, 10, 7, 7, '#f6f7fb'); r(103, 10, 1, 1, '#9aa3b2'); r(103, 16, 1, 1, '#9aa3b2');
        // Papan pengumuman gabus dengan catatan berpaku.
