# Disalin ke supabase/functions/.env untuk `supabase functions serve`. Jangan commit .env.
# Kunci bersama yang dikirim Voice Gateway / Hermes lewat header x-sigap-kunci.
SIGAP_KUNCI_INTERNAL=ganti-dengan-string-acak-panjang
# Kunci terpisah yang dikirim server dashboard ke fungsi login. Selama kosong, fungsi login tidak mewajibkan kunci
# (saklar rollout, lihat supabase/README.md).
SIGAP_KUNCI_LOGIN=ganti-dengan-string-acak-panjang
# tiruan (default) atau resmi setelah akses API cekbpom tersedia.
CEKBPOM_ADAPTER=tiruan
# Origin dashboard yang boleh memanggil simpan-materi dari browser, dipisah koma. Kosong berarti hanya panggilan server
# ke server dari Astro (/api/simpan-materi), yang tidak butuh CORS.
# SIGAP_ASAL_DASHBOARD=
# Alamat cekbpom untuk adapter resmi (CEKBPOM_ADAPTER=resmi).
CEKBPOM_BASE_URL=https://cekbpom.pom.go.id
