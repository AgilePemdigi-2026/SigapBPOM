# Variabel Lingkungan SIGAP BPOM
# Salin berkas ini ke `.env` untuk menjalankan secara lokal. Jangan pernah meng-commit berkas `.env`!

# Supabase Auth dan Basis Data (lokal default: http://127.0.0.1:54321)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ganti-dengan-anon-key-anda

# Pengaturan Sesi Petugas (NFR-12: batas waktu idle dalam menit, default: 30)
SESI_IDLE_MENIT=30

# Mode adapter autentikasi: kosong (default: supabase) atau 'tiruan' untuk demo offline tanpa database
# AUTH_ADAPTER=tiruan
