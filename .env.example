# Dashboard Astro (server). Nilai di bawah hanya placeholder, isi di .env yang tidak di-commit.
# Kunci anon saja: service_role tidak dipakai dashboard.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=isi-kunci-anon-supabase
# Kunci server untuk Edge Function login (header x-sigap-kunci), sama dengan secret SIGAP_KUNCI_LOGIN di Supabase.
# Hanya dipakai server dashboard dan tidak pernah dikirim ke browser.
SIGAP_KUNCI_LOGIN=ganti-dengan-string-acak-panjang

# Voice Gateway yang diperiksa halaman Pantau AI Agent (T-F5.4-01), dari sisi server dashboard. Tanpa nilai ini, build
# produksi menampilkan semua komponen Gangguan dan pengembangan lokal memakai data kesehatan tiruan.
VOICE_GATEWAY_URL=http://127.0.0.1:8090

# Deployment tanpa Caddy bersama gateway (Coolify): Astro meneruskan /voice/* ke VOICE_GATEWAY_URL. Isi kunci yang sama
# dengan PROXY_KUNCI gateway agar batas per IP memakai alamat penelepon, bukan IP server dashboard.
# VOICE_PROXY_KUNCI=
# Hanya di balik Cloudflare dengan port asal tertutup: alamat klien dibaca dari CF-Connecting-IP.
# PERCAYA_CF_CONNECTING_IP=1

# Hanya untuk pengembangan lokal tanpa Supabase: SIGAP_SESI=tiruan memakai akun demo. Diabaikan di build produksi.
# SIGAP_SESI=tiruan

# NFR-12: batas idle sesi dalam menit (bawaan 30). Perkecil untuk pengujian.
# SESI_IDLE_MENIT=1

# PROJECT_RULES 5.2: batas login per IP (bawaan 20 per 15 menit). Naikkan hanya untuk uji @ui lokal (features/README.md).
# LOGIN_PERCOBAAN_MAKS=1000
