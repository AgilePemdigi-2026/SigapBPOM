# Variabel Voice Gateway (nilai contoh). Jangan commit .env.
# Gateway tidak membaca .env sendiri: saat lokal jalankan `node --env-file=voice-gateway/.env voice-gateway/server.mjs`,
# di VPS nilainya diteruskan lewat daftar `environment` service voice di docker compose (variabel baru ditambahkan di sana).
# Baris bertanda # memakai nilai bawaan yang tertulis; hapus tandanya hanya bila perlu mengubahnya.

# Server
# PORT=8090
# production (bawaan image Docker) mewajibkan SUPABASE_URL dan SIGAP_KUNCI_INTERNAL; bila salah satunya kosong, gateway berhenti saat start.
# NODE_ENV=
# Origin halaman publik. POST dari origin lain ditolak 403; kosong berarti origin tidak diperiksa.
SITE_ORIGIN=http://localhost:4321
# Korpus RAG lokal. Bawaannya knowledge/regulasi-bpom di akar repo; image Docker memakai /app/knowledge.
# KORPUS_DIR=knowledge/regulasi-bpom

# ElevenLabs STT dan TTS (ADR 0003)
ELEVENLABS_API_KEY=isi-kunci-elevenlabs
# 0 mematikan transkrip live (STT realtime); panel kembali ke rekam lalu unggah.
# STT_REALTIME=1
# Model STT untuk rekam lalu unggah saja. STT realtime selalu memakai scribe_v2_realtime.
# ELEVENLABS_STT_MODEL=scribe_v2
# ELEVENLABS_VOICE_ID=HnnPtoATgzx4ubChwm24
# ELEVENLABS_TTS_MODEL=eleven_v3_conversational
# Model v3 hanya menerima 0, 0.5, atau 1.
# ELEVENLABS_TTS_STABILITY=0.5

# Hermes Agent (berjalan di host VPS, bukan container)
HERMES_URL=http://host.docker.internal:8642
HERMES_API_KEY=isi-kunci-hermes
# HERMES_MODEL=sigap-hermes

# Kuota harian (total dan per IP) dan batas per panggilan
# TTS_KARAKTER_HARIAN=6000
# TTS_KARAKTER_HARIAN_PER_IP=1500
# AI_TOKEN_HARIAN=500000
# AI_TOKEN_HARIAN_PER_IP=100000
# AI_TOKEN_PER_PANGGILAN=40000
# AI_GILIRAN_SERENTAK_PER_IP=3

# Supabase: tiket, transkrip, panggilan aktif, dan katalog materi lewat Edge Functions. Kunci sama dengan
# SIGAP_KUNCI_INTERNAL di supabase/functions/.env. Bila salah satunya kosong, gateway memakai penyimpanan tiruan di memori
# (hanya pengembangan lokal, lihat NODE_ENV).
SUPABASE_URL=http://127.0.0.1:54321
SIGAP_KUNCI_INTERNAL=ganti-dengan-string-acak-panjang

# cekbpom
# 1 menyalakan cek registrasi produk lewat scraping cekbpom.pom.go.id; selain itu mati (dev lokal, tes, demo).
CEKBPOM_AKTIF=0
CEKBPOM_BASE_URL=https://cekbpom.pom.go.id
# Hanya untuk uji beban (ujiKinerja.mjs), yang mengarahkannya ke ElevenLabs tiruan. Biarkan kosong di produksi.
# ELEVENLABS_URL=https://api.elevenlabs.io

# Basis pengetahuan
# 1 memakai pencarian vektor Edge Function cari-pengetahuan (butuh Supabase di atas); selain itu korpus lokal.
# PENGETAHUAN_VEKTOR=0
# Jeda sinkron katalog materi dari Supabase, dalam milidetik.
# KATALOG_SINKRON_MS=300000

# Batas penerbitan tiket ESK dan ADU
# TIKET_PER_PANGGILAN=2
# TIKET_HARIAN_PER_IP=5
# TIKET_HARIAN_PER_NOMOR=3
